---
import PortfolioLayout from '../layouts/Portfolio.astro';
import LaptopTransition from '../components/LaptopTransition.astro';
import PublicationShelf from '../components/PublicationShelf.astro';
import HongKongExperience from '../components/HongKongExperience.astro';
import PracticeSection from '../components/PracticeSection.astro';
import PracticeOverview from '../components/PracticeOverview.astro';
import ProfileFeature from '../components/ProfileFeature.astro';
import { portfolioCards, portfolioDetails } from '../data/portfolio';
import { settings } from '../config/settings';

const displayName = 'DR HAO WU';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetBase = `${base}assets/figma/skills/`;

const seo = {
	title: displayName,
	description: settings.author.bio,
};
---

<PortfolioLayout {seo}>
	<section class="home-page" aria-label="Hao Wu portfolio">
		<ProfileFeature />

		<PracticeOverview />
		<PublicationShelf base={base} />
		<HongKongExperience base={base} />
		<LaptopTransition />

		<div class="home-page__sections" aria-label="Practice details">
			{portfolioCards.filter((card) => card.slug !== 'media-research' && card.slug !== 'visual-design' && card.slug !== 'video-production').map((card) => (
				<PracticeSection page={portfolioDetails[card.slug]} {assetBase} {base} />
			))}
		</div>

	</section>
</PortfolioLayout>

<style>
	.home-page {
		width: min(100%, 1440px);
		min-height: calc(100svh - 4.5rem);
		margin: 0 auto;
		padding: clamp(1.5rem, 3vw, 3rem) clamp(1.25rem, 7vw, 8.5rem) clamp(3rem, 5vw, 5rem);
	}

	.home-page__sections {
		margin-top: clamp(2rem, 4vw, 4rem);
	}

	@media (max-width: 800px) {
		.home-page {
			padding-top: 4rem;
		}

	}
</style>
