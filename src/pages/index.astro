---
import PortfolioLayout from '../layouts/Portfolio.astro';
import NavigationCard from '../components/NavigationCard.astro';
import PracticeSection from '../components/PracticeSection.astro';
import { portfolioCards, portfolioDetails } from '../data/portfolio';
import { settings } from '../config/settings';

const displayName = 'DR HAO WU';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetBase = `${base}assets/figma/skills/`;

const seo = {
	title: displayName,
	description: settings.author.bio,
};
---

<PortfolioLayout {seo}>
	<section class="home-page" id="about" aria-labelledby="home-title">
		<div class="home-page__intro">
			<p class="home-page__eyebrow">Digital media / Research / Practice</p>
			<h1 id="home-title">Dr Hao Wu</h1>
			<p class="home-page__lead">I’m Dr. Hao Wu — a digital media creator and researcher working between visual design, video production and public-facing research.</p>
		</div>

		<div class="home-page__cards" id="practices">
			{portfolioCards.map((card) => (
				<NavigationCard {...card} href={`#${card.slug}`} {assetBase} />
			))}
		</div>

		<div class="home-page__hint">
			<span>Choose a practice to jump to its section</span>
			<span aria-hidden="true">↓</span>
		</div>

		<div class="home-page__sections" aria-label="Practice details">
			{portfolioCards.map((card) => (
				<PracticeSection page={portfolioDetails[card.slug]} {assetBase} {base} />
			))}
		</div>
	</section>
</PortfolioLayout>

<style>
	.home-page {
		width: min(100%, 1440px);
		min-height: calc(100svh - 4.5rem);
		margin: 0 auto;
		padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 7vw, 8.5rem) clamp(3rem, 5vw, 5rem);
	}

	.home-page__intro {
		max-width: 54rem;
		margin: 0 auto;
		text-align: center;
	}

	.home-page__eyebrow {
		margin: 0 0 1.2rem;
		color: #ff9a00;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.home-page h1 {
		margin: 0;
		font-size: clamp(3.4rem, 7.4vw, 7.6rem);
		font-weight: 700;
		letter-spacing: -0.08em;
		line-height: 0.9;
	}

	.home-page h1 em {
		color: #ff9a00;
		font-style: normal;
	}

	.home-page__lead {
		max-width: 36rem;
		margin: 1.8rem auto 0;
		color: #344054;
		font-size: clamp(0.95rem, 1.3vw, 1.15rem);
		line-height: 1.55;
	}

	.home-page__cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 2rem);
		margin-top: clamp(3rem, 6vw, 6.5rem);
	}

	.home-page__cards :global(.navigation-card:nth-child(2)) {
		transform: translateY(clamp(1rem, 2vw, 2rem));
	}

	.home-page__cards :global(.navigation-card:nth-child(2):hover),
	.home-page__cards :global(.navigation-card:nth-child(2):focus-visible) {
		transform: translateY(clamp(0.5rem, 1vw, 1rem));
	}

	.home-page__hint {
		display: flex;
		justify-content: space-between;
		max-width: 76rem;
		margin: clamp(2rem, 5vw, 4rem) auto 0;
		color: #6b7178;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.home-page__sections {
		margin-top: clamp(4rem, 9vw, 9rem);
	}

	@media (max-width: 800px) {
		.home-page {
			padding-top: 4rem;
		}

		.home-page__cards {
			grid-template-columns: 1fr;
			max-width: 32rem;
			margin-right: auto;
			margin-left: auto;
		}

		.home-page__cards :global(.navigation-card:nth-child(2)) {
			transform: none;
		}

		.home-page__cards :global(.navigation-card:nth-child(2):hover),
		.home-page__cards :global(.navigation-card:nth-child(2):focus-visible) {
			transform: translateY(-8px);
		}
	}
</style>
