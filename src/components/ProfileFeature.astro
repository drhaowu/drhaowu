---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const avatarBase = `${base}assets/images/hao/`;
const avatarLogo = `${avatarBase}hao-wu-avatar-logo.png`;
const heroTitle = 'Hao Wu';
---

<section class="profile-feature" aria-labelledby="profile-feature-title">
	<div class="profile-feature__stage">
		<p class="profile-feature__eyebrow">Research · Media · Design</p>
		<h1 class="profile-feature__title" id="profile-feature-title" aria-label={heroTitle}>
			{heroTitle.split('').map((letter, index) => (
				<span class="profile-feature__title-letter" aria-hidden="true" style={`--title-letter-index: ${index};`}>
					{letter === ' ' ? '\u00a0' : letter}
				</span>
			))}
		</h1>
		<p class="profile-feature__stage-note">A curious practice moving between questions, screens and places.</p>

		<div class="profile-feature__character" data-character>
			<div class="profile-feature__character-glow" aria-hidden="true"></div>
			<div class="profile-feature__character-image">
				<img
					data-avatar-image
					src={`${avatarBase}hao-wu-avatar-transparent.png`}
					alt="A 3D illustrated avatar of Hao Wu thinking with a silver laptop"
					width="1024"
					height="1536"
					loading="eager"
					decoding="async"
				/>
				<img
					class="profile-feature__laptop-mark"
					src={avatarLogo}
					alt=""
					width="1254"
					height="1254"
					loading="eager"
					decoding="async"
					aria-hidden="true"
				/>
			</div>
		</div>

		<div class="profile-feature__cards" aria-label="Explore Hao Wu's connected practices">
			<a class="profile-feature__card profile-feature__card--research" href="#research">
				<span class="profile-feature__card-icon" aria-hidden="true">⌬</span>
				<span>Research</span>
				<span class="profile-feature__card-line" aria-hidden="true"></span>
			</a>
			<a class="profile-feature__card profile-feature__card--media" href="#video-production">
				<span class="profile-feature__card-icon" aria-hidden="true">▷</span>
				<span>Media</span>
				<span class="profile-feature__card-line" aria-hidden="true"></span>
			</a>
			<a class="profile-feature__card profile-feature__card--design" href="#visual-design-showcase">
				<span class="profile-feature__card-icon" aria-hidden="true">✦</span>
				<span>Design</span>
				<span class="profile-feature__card-line" aria-hidden="true"></span>
			</a>
		</div>

		<a class="profile-feature__scroll" href="#about" aria-label="Scroll to About Me">
			<span>Scroll to explore</span><span aria-hidden="true">↓</span>
		</a>
	</div>

</section>

<style>
	.profile-feature {
		position: relative;
		z-index: 1;
		width: 100vw;
		margin: 0 auto;
		margin-left: calc(50% - 50vw);
		padding: 0 0 clamp(2rem, 5vw, 4rem);
		background: transparent;
	}

	.profile-feature__stage {
		position: relative;
		display: grid;
		min-height: max(100vh, 100svh);
		place-items: center;
		isolation: isolate;
		padding: clamp(5rem, 8vw, 7rem) 1rem clamp(5.5rem, 10vw, 8rem);
		background: transparent;
		overflow: hidden;
	}

	.profile-feature__stage::before,
	.profile-feature__stage::after {
		display: none;
		position: absolute;
		border-radius: 50%;
		content: '';
		pointer-events: none;
	}

	.profile-feature__stage::before {
		top: -20%;
		left: -12%;
		width: 38rem;
		aspect-ratio: 1;
		background: rgba(157, 205, 255, 0.34);
		filter: blur(22px);
		animation: profile-orb-one 16s ease-in-out infinite;
	}

	.profile-feature__stage::after {
		right: -14%;
		bottom: -28%;
		width: 34rem;
		aspect-ratio: 1;
		background: rgba(107, 124, 255, 0.22);
		filter: blur(30px);
		animation: profile-orb-two 19s ease-in-out infinite;
	}

	.profile-feature__eyebrow,
	.profile-feature__support-eyebrow {
		position: relative;
		z-index: 4;
		margin: 0;
		color: #1769e8;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.profile-feature__eyebrow,
	.profile-feature__stage-note {
		display: none;
	}

	.profile-feature__eyebrow {
		position: absolute;
		top: 2rem;
		left: clamp(1.2rem, 4vw, 3rem);
	}

	.profile-feature__title {
		position: absolute;
		top: 11%;
		left: 50%;
		z-index: 0;
		width: 100%;
		margin: 0;
		color: rgba(47, 118, 237, 0.16);
		font-size: clamp(8rem, 26vw, 23rem);
		font-weight: 800;
		letter-spacing: -0.12em;
		line-height: 0.78;
		text-align: center;
		pointer-events: none;
		transform: translateX(-50%);
		white-space: nowrap;
		overflow: visible;
		clip-path: inset(0 100% 0 0);
		animation: profile-title-reveal 1.08s cubic-bezier(0.16, 1, 0.3, 1) 80ms both;
	}

	.profile-feature__title-letter {
		display: inline-block;
		opacity: 0.72;
		filter: blur(2px);
		transform: translate3d(-0.08em, 0.08em, 0) rotate(2deg);
		will-change: opacity, filter, transform;
		animation: profile-title-letter-in 560ms cubic-bezier(0.16, 1, 0.3, 1) calc(120ms + var(--title-letter-index) * 55ms) both;
	}

	.profile-feature__stage-note {
		position: absolute;
		top: 2rem;
		right: clamp(1.2rem, 4vw, 3rem);
		z-index: 4;
		max-width: 18rem;
		margin: 0;
		color: #52627a;
		font-size: 0.76rem;
		line-height: 1.45;
		text-align: right;
	}

	.profile-feature__character {
		position: relative;
		z-index: 2;
		align-self: end;
		width: min(37rem, 58vw);
		margin-top: 1.5rem;
		filter: drop-shadow(0 2rem 2.4rem rgba(25, 82, 160, 0.18));
	}

	.profile-feature__character-glow {
		position: absolute;
		right: 7%;
		bottom: 2%;
		left: 7%;
		z-index: -1;
		aspect-ratio: 1.55 / 1;
		border-radius: 999px 999px 0 0;
		background: linear-gradient(180deg, rgba(112, 190, 255, 0.52), rgba(123, 112, 255, 0.26));
		filter: blur(0.5px);
		transform: translateY(2%);
	}

	.profile-feature__character-image {
		position: relative;
		width: 100%;
	}

	.profile-feature__character-image img {
		display: block;
		width: 100%;
		height: auto;
		transition: opacity 170ms ease, filter 170ms ease;
	}

	.profile-feature__character-image img.profile-feature__laptop-mark {
		position: absolute;
		top: 72%;
		left: 50%;
		z-index: 2;
		width: 12%;
		height: auto;
		opacity: 0.92;
		filter: brightness(0) invert(1) drop-shadow(0 0.12rem 0.18rem rgba(46, 76, 125, 0.28));
		pointer-events: none;
		transform: translate(-50%, -50%);
	}

	.profile-feature__character-image img.is-switching {
		opacity: 0.2;
		filter: blur(7px);
	}

	.profile-feature__cards {
		position: absolute;
		bottom: 4.3rem;
		left: 50%;
		z-index: 4;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
		width: min(50rem, 76%);
		pointer-events: none;
		transform: translateX(-50%);
	}

	.profile-feature__card {
		display: grid;
		place-items: center;
		gap: 0.55rem;
		min-height: 7.5rem;
		padding: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.9);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.48);
		box-shadow: 0 1.2rem 2.4rem rgba(25, 82, 160, 0.1), inset 0 1px rgba(255, 255, 255, 0.86);
		backdrop-filter: blur(16px) saturate(150%);
		-webkit-backdrop-filter: blur(16px) saturate(150%);
		color: #173d83;
		font-size: 0.82rem;
		font-weight: 650;
		text-decoration: none;
		pointer-events: auto;
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}

	.profile-feature__card:hover,
	.profile-feature__card:focus-visible {
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 1.5rem 2.8rem rgba(25, 82, 160, 0.2), inset 0 1px rgba(255, 255, 255, 0.96);
		transform: translateY(-7px);
	}

	.profile-feature__card-icon {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border: 2px solid rgba(47, 118, 237, 0.75);
		border-radius: 0.7rem;
		color: #2f76ed;
		font-size: 1.4rem;
		line-height: 1;
	}

	.profile-feature__card-line {
		width: 1.5rem;
		height: 2px;
		border-radius: 999px;
		background: rgba(47, 118, 237, 0.42);
	}

	.profile-feature__card--research {
		animation: profile-bounce-one 5.6s ease-in-out infinite;
	}

	.profile-feature__card--media {
		animation: profile-bounce-two 6.4s ease-in-out infinite;
	}

	.profile-feature__card--design {
		animation: profile-bounce-three 5.9s ease-in-out infinite;
	}

	.profile-feature__controls {
		position: absolute;
		bottom: 1.25rem;
		left: clamp(1.2rem, 4vw, 4rem);
		z-index: 5;
		display: grid;
		gap: 0.55rem;
		justify-items: start;
		display: none;
	}

	.profile-feature__state-dot {
		width: 0.55rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #2f76ed;
		box-shadow: 0 0 0 4px rgba(47, 118, 237, 0.12);
	}

	.profile-feature__controls p {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		color: #637795;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.02em;
	}

	.profile-feature__scroll {
		position: absolute;
		left: 50%;
		bottom: 1.25rem;
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: #2f5fae;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.05em;
		text-decoration: none;
		text-transform: uppercase;
		transform: translateX(-50%);
	}

	.profile-feature__scroll span:first-child {
		display: none;
	}

	.profile-feature__scroll span:last-child {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid rgba(47, 118, 237, 0.28);
		border-radius: 50%;
		font-size: 1rem;
		animation: profile-scroll-bob 2.4s ease-in-out infinite;
	}

	@keyframes profile-orb-one {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(10%, 8%, 0) scale(1.12); }
	}

	@keyframes profile-orb-two {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(-9%, -8%, 0) scale(1.1); }
	}

	@keyframes profile-bounce-one {
		0%, 100% { transform: translate3d(0, 0, 0) rotate(-4deg); }
		50% { transform: translate3d(0, -0.65rem, 0) rotate(3deg); }
	}

	@keyframes profile-bounce-two {
		0%, 100% { transform: translate3d(0, 0, 0) rotate(4deg); }
		50% { transform: translate3d(0, -0.85rem, 0) rotate(-3deg); }
	}

	@keyframes profile-bounce-three {
		0%, 100% { transform: translate3d(0, 0, 0) rotate(-2deg); }
		50% { transform: translate3d(0, -0.55rem, 0) rotate(4deg); }
	}

	@keyframes profile-scroll-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(0.25rem); }
	}

	@keyframes profile-title-reveal {
		0% {
			clip-path: inset(0 100% 0 0);
		}
		100% {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes profile-title-letter-in {
		0% {
			opacity: 0;
			filter: blur(2px);
			transform: translate3d(-0.08em, 0.08em, 0) rotate(2deg);
		}
		100% {
			opacity: 1;
			filter: blur(0);
			transform: translate3d(0, 0, 0) rotate(0);
		}
	}

	@media (max-width: 800px) {
		.profile-feature__stage {
			min-height: max(100vh, 100svh);
			padding-top: 3.6rem;
		}

		.profile-feature__title {
			top: 14%;
			font-size: clamp(6.5rem, 28vw, 11rem);
		}

		.profile-feature__character {
			width: min(29rem, 72vw);
		}

		.profile-feature__cards {
			bottom: 4.25rem;
			width: 82%;
			gap: 0.45rem;
		}

		.profile-feature__card {
			min-height: 6.5rem;
			padding: 0.8rem 0.4rem;
		}

		.profile-feature__support {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}

	@media (max-width: 560px) {
		.profile-feature__stage {
			min-height: max(100vh, 100svh);
			padding-right: 0.75rem;
			padding-left: 0.75rem;
		}

		.profile-feature__title {
			top: 16%;
			font-size: clamp(4rem, 21vw, 7rem);
		}

		.profile-feature__stage-note {
			max-width: 17rem;
			font-size: 0.82rem;
		}

		.profile-feature__character {
			width: min(24rem, 92vw);
			margin-top: 0;
		}

		.profile-feature__cards {
			bottom: 4.15rem;
			width: calc(100% - 1.1rem);
			gap: 0.3rem;
		}

		.profile-feature__card {
			min-height: 5.35rem;
			padding: 0.6rem 0.25rem;
			border-radius: 0.75rem;
			font-size: 0.62rem;
		}

		.profile-feature__card-icon {
			width: 2rem;
			height: 2rem;
			font-size: 1.05rem;
		}

		.profile-feature__card-line {
			width: 1.1rem;
		}

		.profile-feature__controls {
			bottom: 3.7rem;
			left: 1rem;
		}

		.profile-feature__controls p {
			display: none;
		}

		.profile-feature__scroll {
			right: 1rem;
			bottom: 1rem;
		}

		.profile-feature__scroll span:first-child {
			display: none;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.profile-feature__stage::before,
		.profile-feature__stage::after,
		.profile-feature__card,
		.profile-feature__scroll span:last-child {
			animation: none;
		}

		.profile-feature__character-image img {
			transition: none;
		}

		.profile-feature__title-letter {
			animation: none;
			opacity: 1;
			filter: none;
			transform: none;
		}

		.profile-feature__title {
			animation: none;
			clip-path: none;
		}
	}
</style>
