---
import { portfolioCards } from '../data/portfolio';
---

<section class="practice-overview" id="practices" aria-labelledby="practice-overview-title">
	<div class="practice-overview__inner">
		<div class="practice-overview__profile">
			<div class="practice-overview__copy">
				<p class="practice-overview__eyebrow">A profile in practice</p>
				<p class="practice-overview__lead">
					Hao’s creative approach bridges <strong>theory and practice</strong>, supporting inclusive learning and fostering cross-cultural understanding through digital storytelling.
				</p>
				<p class="practice-overview__zh" lang="zh-CN">吴豪一直致力于将理论与实践结合起来，通过媒体叙事的方法支持课堂中的包容性学习，以及跨文化理解。</p>
			</div>

			<div class="practice-overview__stats" aria-label="Profile highlights">
				<div>
					<strong>6 Years</strong>
					<span>Media industry<br />experience</span>
				</div>
				<div>
					<strong>3</strong>
					<span>Connected<br />practices</span>
				</div>
				<div>
					<strong>1</strong>
					<span>Research-to-public<br />pipeline</span>
				</div>
			</div>
		</div>

		<div class="practice-overview__heading">
			<p class="practice-overview__eyebrow">Ways of working</p>
			<h2 id="practice-overview-title"><span>Three </span><em>connected</em><br /><span>practices.</span></h2>
			<p>Choose a thread and follow it down the page.</p>
		</div>

		<nav class="practice-overview__nav" aria-label="Hao Wu's connected practices">
			{portfolioCards.map((card) => (
				<a class="practice-overview__link" href={`#${card.slug}`}>
					<span class="practice-overview__number">{card.number}</span>
					<span class="practice-overview__label">
						<strong>{card.title}</strong>
						<small>{card.chinese} · {card.shortDescription}</small>
					</span>
					<span class="practice-overview__arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</nav>
	</div>
</section>

<style>
	.practice-overview {
		position: relative;
		width: 100vw;
		min-height: max(100vh, 58rem);
		margin-left: calc(50% - 50vw);
		padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 8.5rem) clamp(6rem, 11vw, 11rem);
		background: transparent;
	}

	.practice-overview__inner {
		width: min(100%, 90rem);
		margin: 0 auto;
	}

	.practice-overview__profile {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(25rem, 0.88fr);
		gap: clamp(2.5rem, 7vw, 8rem);
		align-items: end;
	}

	.practice-overview__eyebrow {
		margin: 0 0 1.35rem;
		color: #1769e8;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: clamp(0.65rem, 0.8vw, 0.78rem);
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.practice-overview__copy {
		max-width: 48rem;
	}

	.practice-overview__lead {
		max-width: 44rem;
		margin: 0;
		color: #344d70;
		font-size: clamp(1.35rem, 2.15vw, 2.25rem);
		letter-spacing: -0.045em;
		line-height: 1.2;
	}

	.practice-overview__lead strong {
		color: #1769e8;
		font-weight: 700;
	}

	.practice-overview__zh {
		max-width: 34rem;
		margin: 1.5rem 0 0;
		color: #52627a;
		font-size: clamp(0.92rem, 1.1vw, 1.08rem);
		line-height: 1.75;
	}

	.practice-overview__stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
	}

	.practice-overview__stats div {
		display: grid;
		gap: 0.7rem;
		min-height: 8rem;
		padding: 0 1.25rem;
		border-left: 1px solid rgba(47, 118, 237, 0.2);
	}

	.practice-overview__stats div:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.practice-overview__stats strong {
		color: #1769e8;
		font-size: clamp(1.8rem, 3.3vw, 3.6rem);
		letter-spacing: -0.08em;
		line-height: 0.9;
	}

	.practice-overview__stats span {
		align-self: end;
		color: #667995;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: clamp(0.55rem, 0.72vw, 0.7rem);
		line-height: 1.4;
		text-transform: uppercase;
	}

	.practice-overview__heading {
		margin: clamp(8rem, 15vw, 15rem) auto 0;
		text-align: center;
	}

	.practice-overview__heading .practice-overview__eyebrow {
		margin-bottom: 1.5rem;
	}

	.practice-overview__heading h2 {
		margin: 0;
		color: #171717;
		font-size: clamp(4.4rem, 10.2vw, 10rem);
		font-weight: 800;
		letter-spacing: -0.105em;
		line-height: 0.82;
	}

	.practice-overview__heading h2 em {
		background: linear-gradient(110deg, #1769e8 5%, #42b9ef 52%, #727bff 95%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-style: normal;
	}

	.practice-overview__heading > p:last-child {
		margin: 1.7rem 0 0;
		color: #667995;
		font-size: clamp(1rem, 1.35vw, 1.35rem);
		letter-spacing: -0.025em;
	}

	.practice-overview__nav {
		margin-top: clamp(5rem, 8vw, 8rem);
		border-top: 1px solid rgba(47, 118, 237, 0.2);
	}

	.practice-overview__link {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr) 4.25rem;
		align-items: center;
		min-height: clamp(8rem, 11vw, 11rem);
		padding: 1.1rem 0;
		border-bottom: 1px solid rgba(47, 118, 237, 0.2);
		color: #171717;
		text-decoration: none;
		transition: background-color 220ms ease, color 220ms ease, padding 220ms ease;
	}

	.practice-overview__number {
		align-self: start;
		padding-top: 0.55rem;
		color: #7184b5;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.82rem;
		letter-spacing: 0.06em;
	}

	.practice-overview__label {
		display: grid;
		gap: 0.7rem;
	}

	.practice-overview__label strong {
		font-size: clamp(2.2rem, 5vw, 5rem);
		font-weight: 800;
		letter-spacing: -0.085em;
		line-height: 0.9;
	}

	.practice-overview__label small {
		color: #667995;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: clamp(0.62rem, 0.78vw, 0.78rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.practice-overview__arrow {
		display: grid;
		place-items: center;
		justify-self: end;
		width: 3.3rem;
		height: 3.3rem;
		border: 1px solid rgba(47, 118, 237, 0.32);
		border-radius: 50%;
		color: #1769e8;
		font-size: 1.55rem;
		transition: background-color 220ms ease, color 220ms ease, transform 220ms ease;
	}

	.practice-overview__link:hover,
	.practice-overview__link:focus-visible {
		padding-right: 0.8rem;
		padding-left: 0.8rem;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(184, 218, 255, 0.22), rgba(255, 255, 255, 0));
		color: #1769e8;
	}

	.practice-overview__link:hover .practice-overview__arrow,
	.practice-overview__link:focus-visible .practice-overview__arrow {
		background: #1769e8;
		color: #ffffff;
		transform: translate(0.15rem, -0.15rem);
	}

	@media (max-width: 900px) {
		.practice-overview__profile {
			grid-template-columns: 1fr;
			gap: 3.5rem;
		}

		.practice-overview__stats {
			max-width: 38rem;
		}
	}

	@media (max-width: 560px) {
		.practice-overview {
			padding-right: 1rem;
			padding-left: 1rem;
		}

		.practice-overview__profile {
			gap: 2.5rem;
		}

		.practice-overview__lead {
			font-size: 1.42rem;
		}

		.practice-overview__zh {
			font-size: 0.9rem;
		}

		.practice-overview__stats div {
			min-height: 6.5rem;
			padding: 0 0.6rem;
		}

		.practice-overview__stats div:first-child {
			padding-left: 0;
		}

		.practice-overview__stats strong {
			font-size: 1.5rem;
		}

		.practice-overview__stats span {
			font-size: 0.5rem;
		}

		.practice-overview__heading {
			margin-top: 7rem;
		}

		.practice-overview__heading h2 {
			font-size: clamp(3.5rem, 16vw, 6rem);
		}

		.practice-overview__link {
			grid-template-columns: 2.25rem minmax(0, 1fr) 3rem;
			min-height: 7.5rem;
		}

		.practice-overview__label strong {
			font-size: clamp(1.7rem, 8vw, 2.7rem);
		}

		.practice-overview__label small {
			font-size: 0.52rem;
			line-height: 1.45;
		}

		.practice-overview__arrow {
			width: 2.5rem;
			height: 2.5rem;
			font-size: 1.1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.practice-overview__link,
		.practice-overview__arrow {
			transition: none;
		}
	}
</style>
