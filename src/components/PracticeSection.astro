---
import type { PortfolioDetail as PortfolioDetailData } from '../data/portfolio';

interface Props {
	page: PortfolioDetailData;
	assetBase: string;
	base: string;
}

const { page, assetBase, base } = Astro.props;
---

<section class={`practice-section practice-section--${page.slug}`} id={page.slug} aria-labelledby={`${page.slug}-title`}>
	<div class="practice-section__main">
		<div class="practice-section__copy">
			<h2 id={`${page.slug}-title`}>{page.title}<em>{page.chinese}</em></h2>
		</div>

		<figure class="practice-section__media">
			<div class="practice-section__media-frame">
				<img src={`${assetBase}${page.image}`} alt={page.imageAlt} loading="lazy" decoding="async" />
			</div>
		</figure>
	</div>
</section>

<style>
	.practice-section {
		--section-accent: #1769e8;
		position: relative;
		scroll-margin-top: 5rem;
		padding: clamp(6rem, 12vw, 12rem) clamp(0.25rem, 3vw, 2rem);
	}

	.practice-section + .practice-section {
		margin-top: clamp(1.25rem, 3vw, 3rem);
	}

	.practice-section--video-production {
		--section-accent: #2fb7e8;
	}

	.practice-section--media-research {
		--section-accent: #727bff;
	}

	.practice-section::before {
		position: absolute;
		top: -8%;
		left: 50%;
		width: clamp(10rem, 22vw, 20rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--section-accent);
		content: '';
		filter: blur(68px);
		opacity: 0.12;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.practice-section__header,
	.practice-section__main,
	.practice-section__stories {
		position: relative;
		z-index: 1;
	}

	.practice-section__header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1.1rem;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.65rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.practice-section__label {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		grid-column: 2;
	}

	.practice-section__label span:first-child {
		display: grid;
		place-items: center;
		width: 1.8rem;
		height: 1.8rem;
		color: var(--section-accent);
	}

	.practice-section__deep-link {
		grid-column: 3;
		justify-self: end;
		color: #171717;
		text-decoration: none;
		opacity: 0.62;
		transition: opacity 180ms ease;
	}

	.practice-section__deep-link:hover,
	.practice-section__deep-link:focus-visible {
		opacity: 1;
	}

	.practice-section__deep-link span {
		margin-left: 0.35rem;
		font-size: 0.9rem;
	}

	.practice-section__main {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(3rem, 6vw, 6rem);
		padding: 0;
		text-align: center;
	}

	.practice-section__copy {
		max-width: 43rem;
		margin: 0 auto;
	}

	.practice-section__eyebrow,
	.practice-story__eyebrow {
		margin: 0 0 1.1rem;
		color: var(--section-accent);
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.practice-section h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10.8vw, 10rem);
		font-weight: 700;
		letter-spacing: -0.08em;
		line-height: 0.91;
	}

	.practice-section h2 em {
		display: block;
		margin-top: 0.25em;
		color: var(--section-accent);
		font-size: 0.34em;
		font-style: normal;
		letter-spacing: -0.04em;
	}

	.practice-section__intro {
		max-width: 35rem;
		margin: 1.8rem auto 0;
		color: #344054;
		font-size: 1rem;
		line-height: 1.65;
	}

	.practice-section__keywords {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: 2.4rem auto 0;
		padding: 0;
		list-style: none;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.03em;
	}

	.practice-section__keywords li {
		display: grid;
		gap: 0.5rem;
		padding: 0.75rem;
		text-align: center;
	}

	.practice-section__keywords span {
		color: #6b7178;
	}

	.practice-section__media {
		width: min(100%, 72rem);
		min-width: 0;
		margin-right: auto;
		margin-left: auto;
		text-align: left;
	}

	.practice-section__media-bar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.45rem 0.45rem 0.65rem;
		color: #6b7178;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.6rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.practice-section__media-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--section-accent);
		box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.34);
	}

	.practice-section__media-index {
		margin-left: 0.7rem;
		opacity: 0.65;
	}

	.practice-section__media-frame {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: transparent;
	}

	.practice-section__media-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 500ms ease;
	}

	.practice-section__media-frame img[src*='media-research'] {
		object-fit: contain;
		padding: 1.1rem;
	}

	.practice-section__media:hover img {
		transform: scale(1.025);
	}

	.practice-section__media figcaption {
		padding: 0.6rem 0.45rem 0.1rem;
		color: #6b7178;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.practice-section__stories {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(2.5rem, 5vw, 4rem);
		max-width: 43rem;
		margin: 0 auto;
		padding: 0 0 clamp(0.5rem, 2vw, 1.5rem);
		text-align: center;
	}

	.practice-story {
		max-width: 43rem;
		margin: 0 auto;
		padding-top: 1.3rem;
	}

	.practice-story__eyebrow {
		margin-bottom: 1rem;
		color: #6b7178;
		font-size: 0.6rem;
	}

	.practice-story h3 {
		max-width: 24ch;
		margin: 0;
		margin-right: auto;
		margin-left: auto;
		font-size: clamp(1.35rem, 2.2vw, 2.4rem);
		letter-spacing: -0.055em;
		line-height: 1;
	}

	.practice-story > p:not(.practice-story__eyebrow) {
		max-width: 36rem;
		margin: 1rem auto 0;
		color: #344054;
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.practice-story ul {
		display: grid;
		gap: 0.45rem;
		max-width: 30rem;
		margin: 1.15rem auto 0;
		padding: 0;
		list-style: none;
		font-size: 0.78rem;
		font-weight: 600;
	}

	.practice-story li {
		position: relative;
		padding-left: 1.1rem;
		text-align: left;
	}

	.practice-story li::before {
		position: absolute;
		left: 0;
		color: var(--section-accent);
		content: '↗';
	}

	@media (max-width: 800px) {
		.practice-section__main {
			gap: 2.5rem;
			padding-block: 3.2rem;
		}

		.practice-section__copy {
			max-width: 40rem;
		}
	}

	@media (max-width: 560px) {
		.practice-section {
			scroll-margin-top: 5.5rem;
			padding: 0.8rem;
		}

		.practice-section__header {
			font-size: 0.56rem;
		}

		.practice-section__deep-link {
			font-size: 0.56rem;
		}

		.practice-section__stories {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.practice-section__header {
			grid-template-columns: 2rem 1fr auto;
		}

		.practice-section__label {
			grid-column: 1 / 3;
		}

		.practice-section__deep-link {
			grid-column: 3;
		}

		.practice-section__keywords {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.practice-section__media-frame img {
			transition: none;
		}
	}
</style>

<style>
	/* On the single-page home, each practice is carried by one large title and one visual. */
	.practice-section {
		scroll-margin-top: 5rem;
		padding-top: clamp(6rem, 12vw, 12rem);
		padding-bottom: clamp(6rem, 12vw, 12rem);
	}

	.practice-section__header,
	.practice-section__eyebrow,
	.practice-section__intro,
	.practice-section__keywords,
	.practice-section__media-bar,
	.practice-section__stories {
		display: none;
	}

	.practice-section__main {
		gap: clamp(3rem, 6vw, 6rem);
		padding: 0;
	}

	.practice-section h2 {
		font-family: var(--font-display);
		font-size: clamp(4.5rem, 10.8vw, 10rem);
		line-height: 0.82;
	}

	.practice-section h2 em {
		font-size: 0.34em;
	}

	.practice-section__media-frame {
		aspect-ratio: 16 / 9;
	}

	@media (max-width: 560px) {
		.practice-section {
			padding-top: 6rem;
			padding-bottom: 6rem;
		}

		.practice-section h2 {
			font-size: clamp(3.6rem, 18vw, 6.5rem);
		}
	}
</style>
