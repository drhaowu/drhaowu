---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const visualAsset = `${base}assets/figma/skills/visual-design.png`;
const avatarAsset = `${base}assets/images/hao/hao-wu-avatar-transparent.png`;
---

<section class="laptop-transition" id="laptop-transition" data-laptop-transition aria-labelledby="laptop-transition-title">
	<div class="laptop-transition__scene" data-laptop-scene>
		<div class="laptop-transition__bubble laptop-transition__bubble--one" aria-hidden="true"></div>
		<div class="laptop-transition__bubble laptop-transition__bubble--two" aria-hidden="true"></div>
		<div class="laptop-transition__bubble laptop-transition__bubble--three" aria-hidden="true"></div>

		<div class="laptop-transition__copy">
			<p class="laptop-transition__eyebrow">02 / TURN THE PAGE</p>
			<h2 id="laptop-transition-title">From thinking<br /><em>to making.</em></h2>
			<p>Scroll down and let the computer open the next layer of the practice.</p>
		</div>

		<div class="laptop-transition__falling-character" data-falling-character aria-hidden="true">
			<img src={avatarAsset} alt="" width="1024" height="1536" loading="lazy" decoding="async" />
		</div>

		<div class="laptop-transition__device" data-laptop-device aria-hidden="true">
			<div class="laptop-transition__screen" data-laptop-screen>
				<div class="laptop-transition__screen-inner">
					<div class="laptop-transition__screen-bar">
						<span>CHINA TEL · VISUAL DESIGN</span>
						<span>01 / 03</span>
					</div>
					<div class="laptop-transition__screen-heading">
						<span>Social visuals</span>
						<strong>CTExcel / platform system</strong>
					</div>
					<div class="laptop-transition__case-window">
						<div class="laptop-transition__case-track">
							<figure class="laptop-transition__case-card laptop-transition__case-card--one">
								<img src={visualAsset} alt="China Tel and CTExcel social media design work" loading="lazy" decoding="async" />
								<figcaption>01 / China Tel · CTExcel</figcaption>
							</figure>
							<figure class="laptop-transition__case-card laptop-transition__case-card--two">
								<img src={visualAsset} alt="China Tel platform-adaptive visual system" loading="lazy" decoding="async" />
								<figcaption>02 / Platform adaptation</figcaption>
							</figure>
							<figure class="laptop-transition__case-card laptop-transition__case-card--three">
								<img src={visualAsset} alt="China Tel public-facing social storytelling" loading="lazy" decoding="async" />
								<figcaption>03 / Public-facing design</figcaption>
							</figure>
							<figure class="laptop-transition__case-card laptop-transition__case-card--one" aria-hidden="true">
								<img src={visualAsset} alt="" loading="lazy" decoding="async" />
								<figcaption>01 / China Tel · CTExcel</figcaption>
							</figure>
						</div>
					</div>
					<div class="laptop-transition__screen-footer">
						<span>China Telecom · social content system</span>
						<span>looping case study ↗</span>
					</div>
				</div>
			</div>
			<div class="laptop-transition__base"></div>
		</div>

		<p class="laptop-transition__guide">Scroll to reveal the work <span aria-hidden="true">↓</span></p>
	</div>
</section>

<script is:inline>
	const laptopTransition = document.querySelector('[data-laptop-transition]');

	if (laptopTransition) {
		let frame = 0;

		const clamp = (value) => Math.max(0, Math.min(1, value));
		const updateProgress = () => {
			frame = 0;
			const rect = laptopTransition.getBoundingClientRect();
			const scrollableDistance = Math.max(1, laptopTransition.offsetHeight - window.innerHeight);
			const progress = clamp(-rect.top / scrollableDistance);
			laptopTransition.style.setProperty('--scroll-progress', progress.toFixed(4));
		};
		const requestProgress = () => {
			if (frame) return;
			frame = window.requestAnimationFrame(updateProgress);
		};

		window.addEventListener('scroll', requestProgress, { passive: true });
		window.addEventListener('resize', requestProgress, { passive: true });
		updateProgress();
	}
</script>

<style>
	.laptop-transition {
		--scroll-progress: 0;
		position: relative;
		width: 100vw;
		min-height: 175svh;
		margin-left: calc(50% - 50vw);
	}

	.laptop-transition__scene {
		position: sticky;
		top: 0;
		display: grid;
		min-height: 100svh;
		isolation: isolate;
		overflow: hidden;
		perspective: 1600px;
	}

	.laptop-transition__scene::before,
	.laptop-transition__scene::after {
		position: absolute;
		border-radius: 50%;
		content: '';
		pointer-events: none;
	}

	.laptop-transition__scene::before {
		top: 10%;
		left: -10%;
		width: min(42rem, 56vw);
		aspect-ratio: 1;
		background: radial-gradient(circle at 45% 45%, rgba(87, 151, 255, 0.3), rgba(132, 182, 255, 0.05) 68%, transparent 72%);
		filter: blur(0.2rem);
	}

	.laptop-transition__scene::after {
		right: -14%;
		bottom: -18%;
		width: min(44rem, 58vw);
		aspect-ratio: 1;
		background: radial-gradient(circle at 45% 45%, rgba(112, 125, 255, 0.25), rgba(141, 218, 255, 0.04) 68%, transparent 72%);
		filter: blur(0.2rem);
	}

	.laptop-transition__bubble {
		position: absolute;
		z-index: 0;
		border-radius: 50%;
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.7), rgba(100, 173, 255, 0.18));
		box-shadow: inset 0.15rem 0.15rem 0.6rem rgba(255, 255, 255, 0.9), 0 1.5rem 4rem rgba(54, 119, 226, 0.1);
		animation: laptop-bubble-float 9s ease-in-out infinite;
	}

	.laptop-transition__bubble--one {
		top: 26%;
		left: 10%;
		width: clamp(3rem, 6vw, 6rem);
	}

	.laptop-transition__bubble--two {
		top: 20%;
		right: 14%;
		width: clamp(1.8rem, 3vw, 3.2rem);
		animation-delay: -2.5s;
	}

	.laptop-transition__bubble--three {
		right: 8%;
		bottom: 22%;
		width: clamp(4rem, 8vw, 8rem);
		animation-delay: -5s;
	}

	.laptop-transition__copy {
		position: absolute;
		top: 12%;
		left: clamp(1.2rem, 7vw, 8.5rem);
		z-index: 4;
		max-width: 24rem;
		transition: opacity 300ms ease, transform 500ms ease;
		transform: translateY(calc(var(--scroll-progress) * -5rem));
	}

	.laptop-transition__eyebrow {
		margin: 0 0 1rem;
		color: #1769e8;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.laptop-transition__copy h2 {
		margin: 0;
		font-size: clamp(2.8rem, 6vw, 6rem);
		font-weight: 750;
		letter-spacing: -0.08em;
		line-height: 0.88;
	}

	.laptop-transition__copy h2 em {
		color: #1769e8;
		font-style: normal;
	}

	.laptop-transition__copy > p:last-child {
		max-width: 19rem;
		margin: 1.5rem 0 0;
		color: #52627a;
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.laptop-transition__falling-character {
		position: absolute;
		top: 5%;
		left: 50%;
		z-index: 2;
		width: min(25rem, 42vw);
		pointer-events: none;
		opacity: calc(1 - var(--scroll-progress) * 1.6);
		transform: translate3d(-50%, calc(var(--scroll-progress) * 62vh), 0) rotateZ(calc(var(--scroll-progress) * 11deg)) scale(calc(1 - var(--scroll-progress) * 0.26));
		transform-origin: 50% 20%;
		transition: opacity 120ms linear;
	}

	.laptop-transition__falling-character img {
		display: block;
		width: 100%;
		height: auto;
	}

	.laptop-transition__device {
		position: absolute;
		top: 51%;
		left: 50%;
		z-index: 3;
		width: min(63rem, 86vw);
		height: min(34rem, 48vw);
		transform: translate3d(-50%, calc(-40% + var(--scroll-progress) * 7vh), 0) scale(calc(0.68 + var(--scroll-progress) * 0.32));
		transform-style: preserve-3d;
		transition: transform 100ms linear;
	}

	.laptop-transition__screen {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 2;
		width: 94%;
		aspect-ratio: 16 / 10;
		padding: 0.8rem;
		border-radius: 1.25rem 1.25rem 0.5rem 0.5rem;
		background: linear-gradient(145deg, #e6edf7, #aebdce 56%, #889bb3);
		box-shadow: 0 2rem 4rem rgba(40, 78, 138, 0.2), inset 0 0 0 0.12rem rgba(255, 255, 255, 0.85);
		transform: translateX(-50%) rotateX(calc(54deg - var(--scroll-progress) * 54deg)) translateY(calc((1 - var(--scroll-progress)) * 5rem)) scale(calc(0.72 + var(--scroll-progress) * 0.28));
		transform-origin: 50% 100%;
		transition: transform 100ms linear;
	}

	.laptop-transition__screen-inner {
		display: grid;
		grid-template-rows: auto auto 1fr auto;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 0.7rem;
		background: linear-gradient(145deg, #f9fcff, #eaf3ff);
		box-shadow: inset 0 0 0 1px rgba(37, 92, 170, 0.14);
	}

	.laptop-transition__screen-bar,
	.laptop-transition__screen-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.8rem 1rem;
		color: #355581;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.laptop-transition__screen-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 1rem 0.8rem;
		color: #536b8b;
		font-size: 0.72rem;
	}

	.laptop-transition__screen-heading strong {
		color: #1769e8;
		font-size: clamp(0.85rem, 1.5vw, 1.25rem);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.laptop-transition__case-window {
		min-width: 0;
		overflow: hidden;
	}

	.laptop-transition__case-track {
		display: flex;
		align-items: stretch;
		gap: 1rem;
		width: max-content;
		height: 100%;
		padding: 0.4rem 1rem 0.8rem;
		animation: laptop-case-loop 22s linear infinite;
	}

	.laptop-transition__case-card {
		position: relative;
		width: clamp(13rem, 23vw, 21rem);
		min-width: clamp(13rem, 23vw, 21rem);
		height: 100%;
		margin: 0;
		overflow: hidden;
		background: #ffffff;
		box-shadow: 0 0.8rem 1.8rem rgba(43, 91, 166, 0.12);
	}

	.laptop-transition__case-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.35);
	}

	.laptop-transition__case-card--one img {
		object-position: 4% center;
	}

	.laptop-transition__case-card--two img {
		object-position: 50% center;
	}

	.laptop-transition__case-card--three img {
		object-position: 90% center;
	}

	.laptop-transition__case-card figcaption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 0.55rem 0.75rem;
		background: linear-gradient(180deg, transparent, rgba(14, 41, 81, 0.8));
		color: #ffffff;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.laptop-transition__screen-footer {
		padding-top: 0.5rem;
		padding-bottom: 0.7rem;
		color: #7185a1;
		font-size: 0.5rem;
	}

	.laptop-transition__base {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 3.5rem;
		border-radius: 0 0 1.5rem 1.5rem;
		background: linear-gradient(180deg, #dae4ef, #a9b8ca);
		box-shadow: 0 1.8rem 2rem rgba(37, 79, 138, 0.2), inset 0 0.12rem rgba(255, 255, 255, 0.75);
		transform: perspective(1000px) rotateX(58deg) translateY(1rem);
		transform-origin: top;
	}

	.laptop-transition__base::after {
		position: absolute;
		top: 0.65rem;
		left: 50%;
		width: 16%;
		height: 0.22rem;
		border-radius: 999px;
		background: rgba(81, 112, 151, 0.28);
		content: '';
		transform: translateX(-50%);
	}

	.laptop-transition__guide {
		position: absolute;
		bottom: 1.8rem;
		left: 50%;
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		color: #4c6c9c;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.6rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		transform: translateX(-50%);
	}

	.laptop-transition__guide span {
		font-size: 1rem;
		animation: laptop-guide-bob 2.2s ease-in-out infinite;
	}

	@keyframes laptop-bubble-float {
		0%, 100% { transform: translate3d(0, 0, 0); }
		50% { transform: translate3d(0, -1rem, 0); }
	}

	@keyframes laptop-case-loop {
		0% { transform: translateX(0); }
		100% { transform: translateX(calc(-1 * (clamp(13rem, 23vw, 21rem) + 1rem) * 3)); }
	}

	@keyframes laptop-case-loop-mobile {
		0% { transform: translateX(0); }
		100% { transform: translateX(calc(-1 * (35vw + 0.45rem) * 3)); }
	}

	@keyframes laptop-guide-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(0.25rem); }
	}

	@media (max-width: 700px) {
		.laptop-transition {
			min-height: 155svh;
		}

		.laptop-transition__copy {
			top: 11%;
			left: 1rem;
			max-width: 17rem;
		}

		.laptop-transition__copy h2 {
			font-size: clamp(2.6rem, 12vw, 4.4rem);
		}

		.laptop-transition__copy > p:last-child {
			max-width: 14rem;
			font-size: 0.78rem;
		}

		.laptop-transition__falling-character {
			top: 12%;
			width: min(20rem, 68vw);
		}

		.laptop-transition__device {
			top: 56%;
			width: 94vw;
			height: 48vw;
		}

		.laptop-transition__screen {
			padding: 0.42rem;
			border-radius: 0.7rem 0.7rem 0.3rem 0.3rem;
		}

		.laptop-transition__screen-bar,
		.laptop-transition__screen-footer {
			padding: 0.45rem 0.55rem;
			font-size: 0.4rem;
		}

		.laptop-transition__screen-heading {
			padding: 0.2rem 0.55rem 0.45rem;
			font-size: 0.45rem;
		}

		.laptop-transition__case-track {
			gap: 0.45rem;
			padding: 0.2rem 0.55rem 0.4rem;
			animation-name: laptop-case-loop-mobile;
		}

		.laptop-transition__case-card {
			width: 35vw;
			min-width: 35vw;
		}

		.laptop-transition__case-card figcaption {
			padding: 0.35rem;
			font-size: 0.36rem;
		}

		.laptop-transition__base {
			height: 1.4rem;
			border-radius: 0 0 0.7rem 0.7rem;
		}

		.laptop-transition__guide {
			bottom: 1rem;
			font-size: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.laptop-transition__bubble,
		.laptop-transition__case-track,
		.laptop-transition__guide span {
			animation: none;
		}
	}
</style>
