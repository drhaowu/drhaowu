---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const cards = [
	{
		src: `${base}assets/projects/china-telecom/ctexcel-v2_9069.jpg`,
		alt: 'Visual design with illustrated people, blue and yellow graphics',
	},
	{
		src: `${base}assets/projects/china-telecom/ctexcel-v2_9110.jpg`,
		alt: 'Visual design featuring London and travel storytelling',
	},
	{
		src: `${base}assets/projects/china-telecom/ctexcel-referral-campaign.jpg`,
		alt: 'Visual design for a referral campaign',
	},
	{
		src: `${base}assets/projects/china-telecom/ctexcel-v2_9049.jpg`,
		alt: 'Visual design for a social campaign',
	},
	{
		src: `${base}assets/projects/china-telecom/ctexcel-v2_9140.jpg`,
		alt: 'Visual design for a mobile content system',
	},
];

const columns = [
	{ direction: 'up', cards: cards.slice(0, 3) },
	{ direction: 'down', cards: cards.slice(2, 5) },
];
---

<section class="visual-design-showcase" id="visual-design-showcase" aria-labelledby="visual-design-showcase-title">
	<div class="visual-design-showcase__scene">
		<div class="visual-design-showcase__bubble visual-design-showcase__bubble--one" aria-hidden="true"></div>
		<div class="visual-design-showcase__bubble visual-design-showcase__bubble--two" aria-hidden="true"></div>

		<h2 id="visual-design-showcase-title"><span>Visual</span><em>Design</em></h2>

		<div class="visual-design-showcase__television" role="img" aria-label="A small television showing a looping selection of Hao Wu's visual design work">
			<span class="visual-design-showcase__antenna" aria-hidden="true"></span>
			<span class="visual-design-showcase__body">
				<span class="visual-design-showcase__screen">
					<span class="visual-design-showcase__marquee" aria-hidden="true">
						{columns.map(({ direction, cards: columnCards }) => (
							<span class={`visual-design-showcase__column visual-design-showcase__column--${direction}`}>
								<span class="visual-design-showcase__track">
									{[0, 1].map(() => (
										<span class="visual-design-showcase__set">
											{columnCards.map((card) => (
												<img src={card.src} alt="" loading="lazy" decoding="async" />
											))}
										</span>
									))}
								</span>
							</span>
						))}
					</span>
				</span>
				<span class="visual-design-showcase__controls" aria-hidden="true"><i></i><i></i><i></i></span>
			</span>
			<span class="visual-design-showcase__stand" aria-hidden="true"></span>
		</div>
	</div>
</section>

<style>
	.visual-design-showcase {
		position: relative;
		width: 100vw;
		min-height: max(42rem, 88svh);
		margin-left: calc(50% - 50vw);
		overflow: hidden;
		scroll-margin-top: 5rem;
	}

	.visual-design-showcase__scene {
		position: relative;
		display: flex;
		min-height: max(42rem, 88svh);
		flex-direction: column;
		align-items: center;
		padding: var(--section-space) clamp(1rem, 5vw, 5rem) clamp(3.5rem, 7vw, 6rem);
		isolation: isolate;
		overflow: hidden;
		background: transparent;
	}

	.visual-design-showcase__scene::before,
	.visual-design-showcase__scene::after {
		position: absolute;
		border-radius: 50%;
		content: '';
		pointer-events: none;
	}

	.visual-design-showcase__scene::before {
		top: -12%;
		left: -14%;
		width: min(43rem, 58vw);
		aspect-ratio: 1;
		background: radial-gradient(circle at 52% 48%, rgba(117, 177, 255, 0.18), transparent 69%);
	}

	.visual-design-showcase__scene::after {
		right: -12%;
		bottom: -26%;
		width: min(45rem, 60vw);
		aspect-ratio: 1;
		background: radial-gradient(circle at 46% 42%, rgba(128, 134, 255, 0.18), transparent 69%);
	}

	.visual-design-showcase__bubble {
		position: absolute;
		z-index: 0;
		border-radius: 50%;
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(100, 173, 255, 0.14));
		box-shadow: inset 0.15rem 0.15rem 0.6rem rgba(255, 255, 255, 0.92), 0 1.5rem 4rem rgba(54, 119, 226, 0.08);
	}

	.visual-design-showcase__bubble--one {
		top: 22%;
		left: 8%;
		width: clamp(3rem, 6vw, 6rem);
	}

	.visual-design-showcase__bubble--two {
		top: 14%;
		right: 12%;
		width: clamp(1.8rem, 3vw, 3.2rem);
	}

	.visual-design-showcase h2 {
		position: relative;
		z-index: 1;
		margin: 0;
		color: #171717;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 11.5vw, 11rem);
		font-weight: 800;
		letter-spacing: -0.105em;
		line-height: 0.8;
		text-align: center;
	}

	.visual-design-showcase h2 span,
	.visual-design-showcase h2 em {
		display: block;
	}

	.visual-design-showcase h2 em {
		background: linear-gradient(110deg, #1769e8 5%, #42b9ef 52%, #727bff 95%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-style: normal;
	}

	.visual-design-showcase__television {
		position: relative;
		z-index: 2;
		width: min(62rem, 86vw);
		margin-top: clamp(3rem, 5vw, 5rem);
		padding: clamp(0.7rem, 1.3vw, 1.1rem) clamp(0.7rem, 1.3vw, 1.1rem) clamp(1rem, 1.8vw, 1.5rem);
		border-radius: clamp(1.6rem, 3vw, 3rem) clamp(1.6rem, 3vw, 3rem) clamp(1.1rem, 2vw, 2rem) clamp(1.1rem, 2vw, 2rem);
		background: linear-gradient(145deg, #e8f1ff, #9bbdff 52%, #6e84f3);
		box-shadow: 1.4rem 1.8rem 2.8rem rgba(38, 82, 148, 0.2), inset 0.2rem 0.2rem 0.35rem rgba(255, 255, 255, 0.75);
		transform: rotate(-2deg);
	}

	.visual-design-showcase__antenna {
		position: absolute;
		top: -1.4rem;
		left: 50%;
		width: 4.5rem;
		height: 1.65rem;
		border-top: 0.2rem solid #6078d8;
		transform: translateX(-50%);
	}

	.visual-design-showcase__antenna::before,
	.visual-design-showcase__antenna::after {
		position: absolute;
		top: -0.5rem;
		width: 0.2rem;
		height: 1.1rem;
		border-radius: 999px;
		background: #6078d8;
		content: '';
	}

	.visual-design-showcase__antenna::before {
		left: 0.2rem;
		transform: rotate(-35deg);
	}

	.visual-design-showcase__antenna::after {
		right: 0.2rem;
		transform: rotate(35deg);
	}

	.visual-design-showcase__body {
		display: block;
		padding: clamp(0.55rem, 1vw, 0.85rem);
		border-radius: clamp(1rem, 2vw, 1.8rem);
		background: linear-gradient(145deg, #f8fbff, #c1d4ff);
	}

	.visual-design-showcase__screen {
		display: block;
		height: clamp(24rem, 48vw, 40rem);
		overflow: hidden;
		border-radius: clamp(0.8rem, 1.5vw, 1.4rem);
		background: #17243f;
		box-shadow: inset 0 0 0 0.25rem rgba(24, 45, 89, 0.5), inset 0 0.4rem 1.1rem rgba(0, 0, 0, 0.22);
	}

	.visual-design-showcase__marquee {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.5rem, 1vw, 0.8rem);
		width: 100%;
		height: 100%;
		padding: clamp(0.55rem, 1vw, 0.9rem);
	}

	.visual-design-showcase__column {
		display: block;
		height: 100%;
		overflow: hidden;
		border-radius: clamp(0.4rem, 0.8vw, 0.75rem);
	}

	.visual-design-showcase__track {
		display: block;
		height: 200%;
	}

	.visual-design-showcase__column--up .visual-design-showcase__track {
		animation: visual-design-scroll-up 24s linear infinite;
	}

	.visual-design-showcase__column--down .visual-design-showcase__track {
		animation: visual-design-scroll-down 27s linear infinite;
	}

	.visual-design-showcase__set {
		display: grid;
		grid-template-rows: repeat(3, minmax(0, 1fr));
		gap: clamp(0.45rem, 0.9vw, 0.75rem);
		height: 50%;
	}

	.visual-design-showcase__set img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 0;
		border-radius: clamp(0.35rem, 0.7vw, 0.65rem);
		object-fit: contain;
		object-position: center;
		background: #f8fbff;
		box-shadow: 0 0.4rem 1rem rgba(15, 34, 68, 0.22);
	}

	.visual-design-showcase__controls {
		display: flex;
		justify-content: flex-end;
		gap: 0.45rem;
		padding: 0.7rem 0.3rem 0.1rem;
	}

	.visual-design-showcase__controls i {
		display: block;
		width: 0.52rem;
		height: 0.52rem;
		border-radius: 50%;
		background: #5474db;
		box-shadow: inset 0 0.08rem 0.12rem rgba(255, 255, 255, 0.75);
	}

	.visual-design-showcase__stand {
		display: block;
		width: 38%;
		height: clamp(0.55rem, 1vw, 0.85rem);
		margin: -0.02rem auto 0;
		border-radius: 0 0 999px 999px;
		background: linear-gradient(180deg, #8ca9f2, #6078d8);
	}

	@keyframes visual-design-scroll-up {
		from {
			transform: translateY(0);
		}

		to {
			transform: translateY(-50%);
		}
	}

	@keyframes visual-design-scroll-down {
		from {
			transform: translateY(-50%);
		}

		to {
			transform: translateY(0);
		}
	}

	@media (max-width: 700px) {
		.visual-design-showcase,
		.visual-design-showcase__scene {
			min-height: max(34rem, 74svh);
		}

		.visual-design-showcase__scene {
			padding: 5rem 0.8rem 3rem;
		}

		.visual-design-showcase h2 {
			font-size: clamp(4.5rem, 20vw, 7rem);
		}

		.visual-design-showcase__television {
			width: min(94vw, 35rem);
			margin-top: 3rem;
			transform: rotate(-1deg);
		}

		.visual-design-showcase__screen {
			height: clamp(17rem, 65vw, 24rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.visual-design-showcase__column--up .visual-design-showcase__track,
		.visual-design-showcase__column--down .visual-design-showcase__track {
			animation-play-state: paused;
		}
	}
</style>
