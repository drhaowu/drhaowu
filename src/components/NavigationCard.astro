---
import type { PortfolioCard } from '../data/portfolio';

interface Props extends PortfolioCard {
	href: string;
	assetBase: string;
}

const { number, title, chinese, shortDescription, image, imageAlt, icon, accent, href, assetBase } = Astro.props;
---

<a class="navigation-card" href={href} style={`--card-accent: ${accent}`}>
	<div class="navigation-card__topline">
		<span>{number}</span>
		<span class="navigation-card__topline-tools">
			{icon && <img src={`${assetBase}${icon}`} alt="" aria-hidden="true" />}
			<span class="navigation-card__arrow" aria-hidden="true">↗</span>
		</span>
	</div>
	<div class="navigation-card__copy">
		<h2>{title}</h2>
		<p>{chinese}</p>
		<span>{shortDescription}</span>
	</div>
	<div class="navigation-card__image">
		<img src={`${assetBase}${image}`} alt={imageAlt} loading="lazy" decoding="async" />
	</div>
	<span class="navigation-card__open">Explore <span aria-hidden="true">→</span></span>
</a>

<style>
	.navigation-card {
		position: relative;
		display: flex;
		min-height: clamp(22rem, 34vw, 30rem);
		flex-direction: column;
		overflow: hidden;
		padding: clamp(1.2rem, 2.2vw, 2rem);
		border: 1px solid rgba(255, 255, 255, 0.72);
		border-radius: 1.5rem;
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.56), rgba(255, 255, 255, 0.21) 60%, rgba(255, 255, 255, 0.38));
		box-shadow: 0 1.2rem 3.5rem rgba(34, 49, 68, 0.1), inset 0 1px rgba(255, 255, 255, 0.84), inset 0 -1px rgba(255, 255, 255, 0.18);
		color: #171717;
		text-decoration: none;
		backdrop-filter: blur(28px) saturate(150%);
		-webkit-backdrop-filter: blur(28px) saturate(150%);
		transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease, background 260ms ease;
	}

	.navigation-card::before {
		position: absolute;
		top: -18%;
		right: -12%;
		width: 58%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--card-accent);
		content: '';
		filter: blur(45px);
		opacity: 0.18;
		transition: transform 260ms ease, opacity 260ms ease;
	}

	.navigation-card::after {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), transparent 38%, rgba(255, 255, 255, 0.08));
		content: '';
		pointer-events: none;
	}

	.navigation-card:hover,
	.navigation-card:focus-visible {
		border-color: rgba(255, 255, 255, 0.95);
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.25) 60%, rgba(255, 255, 255, 0.42));
		box-shadow: 0 1.8rem 4.5rem rgba(34, 49, 68, 0.16), inset 0 1px rgba(255, 255, 255, 0.94), inset 0 -1px rgba(255, 255, 255, 0.22);
		transform: translateY(-8px);
	}

	.navigation-card:hover::before,
	.navigation-card:focus-visible::before {
		opacity: 0.4;
		transform: scale(1.22);
	}

	.navigation-card__topline,
	.navigation-card__copy,
	.navigation-card__open {
		position: relative;
		z-index: 1;
	}

	.navigation-card__topline {
		display: flex;
		justify-content: space-between;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.05em;
	}

	.navigation-card__topline-tools {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.navigation-card__topline-tools > img {
		width: 1.6rem;
		height: 1.6rem;
		opacity: 0.82;
		transition: transform 260ms ease, opacity 260ms ease;
	}

	.navigation-card__arrow {
		display: grid;
		place-items: center;
		width: 2.15rem;
		height: 2.15rem;
		border: 1px solid rgba(23, 23, 23, 0.15);
		border-radius: 50%;
		font-size: 1rem;
		transition: background 180ms ease, color 180ms ease;
	}

	.navigation-card:hover .navigation-card__arrow,
	.navigation-card:focus-visible .navigation-card__arrow {
		background: #171717;
		color: #fff;
	}

	.navigation-card:hover .navigation-card__topline-tools > img,
	.navigation-card:focus-visible .navigation-card__topline-tools > img {
		opacity: 1;
		transform: rotate(12deg) scale(1.08);
	}

	.navigation-card__copy {
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
	}

	.navigation-card__copy h2 {
		margin: 0;
		font-size: clamp(1.55rem, 2.35vw, 2.45rem);
		font-weight: 700;
		letter-spacing: -0.06em;
		line-height: 0.98;
	}

	.navigation-card__copy p {
		margin: 0.45rem 0 0;
		color: #344054;
		font-size: 0.88rem;
	}

	.navigation-card__copy > span {
		display: block;
		margin-top: 1rem;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.navigation-card__image {
		position: relative;
		z-index: 1;
		flex: 1;
		min-height: 8rem;
		margin: 2rem 0 1.5rem;
		overflow: hidden;
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.52);
		background: rgba(255, 255, 255, 0.24);
		box-shadow: inset 0 1px rgba(255, 255, 255, 0.62), 0 0.6rem 1.4rem rgba(34, 49, 68, 0.06);
		backdrop-filter: blur(12px) saturate(125%);
		-webkit-backdrop-filter: blur(12px) saturate(125%);
	}

	.navigation-card__image::after {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(255, 255, 255, 0.35);
		border-radius: inherit;
		content: '';
	}

	.navigation-card__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 360ms ease;
	}

	.navigation-card:nth-child(2) .navigation-card__image img {
		object-position: center 28%;
	}

	.navigation-card:nth-child(3) .navigation-card__image img {
		object-position: center;
	}

	.navigation-card:hover .navigation-card__image img,
	.navigation-card:focus-visible .navigation-card__image img {
		transform: scale(1.04);
	}

	.navigation-card__open {
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.navigation-card__open span {
		margin-left: 0.3rem;
		font-size: 1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.navigation-card,
		.navigation-card::before,
		.navigation-card__image img,
		.navigation-card__topline-tools > img {
			transition: none;
		}

		.navigation-card:hover,
		.navigation-card:focus-visible {
			transform: none;
		}
	}
</style>
