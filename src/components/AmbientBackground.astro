<div class="ambient-background" data-ambient aria-hidden="true">
	<span class="ambient-background__orb ambient-background__orb--orange"></span>
	<span class="ambient-background__orb ambient-background__orb--blue"></span>
	<span class="ambient-background__orb ambient-background__orb--mint"></span>
	<span class="ambient-background__grain"></span>
</div>

<script is:inline>
	const ambient = document.querySelector('[data-ambient]');
	const canHover = window.matchMedia('(pointer: fine)').matches;

	if (ambient && canHover) {
		window.addEventListener('pointermove', (event) => {
			ambient.style.setProperty('--pointer-x', `${(event.clientX / window.innerWidth) * 100}%`);
			ambient.style.setProperty('--pointer-y', `${(event.clientY / window.innerHeight) * 100}%`);
		}, { passive: true });
	}
</script>

<style>
	.ambient-background {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		background: #fbfbf8;
		--pointer-x: 50%;
		--pointer-y: 45%;
	}

	.ambient-background__orb {
		position: absolute;
		display: block;
		width: clamp(18rem, 42vw, 52rem);
		aspect-ratio: 1;
		border-radius: 50%;
		filter: blur(clamp(3.5rem, 8vw, 9rem));
		opacity: 0.28;
		will-change: transform;
	}

	.ambient-background__orb--orange {
		top: -22%;
		left: -10%;
		background: #ffc28d;
		animation: ambient-float-one 24s ease-in-out infinite;
	}

	.ambient-background__orb--blue {
		right: -20%;
		bottom: -27%;
		width: clamp(20rem, 45vw, 56rem);
		background: #c5dcff;
		animation: ambient-float-two 29s ease-in-out infinite;
	}

	.ambient-background__orb--mint {
		top: 37%;
		left: 39%;
		width: clamp(14rem, 30vw, 38rem);
		background: #bcecdf;
		opacity: 0.2;
		animation: ambient-float-three 21s ease-in-out infinite;
	}

	.ambient-background::after {
		position: absolute;
		inset: 0;
		content: '';
		background: radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(255, 154, 0, 0.1), transparent 24rem);
		transition: background-position 180ms ease-out;
	}

	.ambient-background__grain {
		position: absolute;
		inset: 0;
		opacity: 0.035;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
	}

	@keyframes ambient-float-one {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(18%, 22%, 0) scale(1.12); }
	}

	@keyframes ambient-float-two {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(-15%, -18%, 0) scale(1.08); }
	}

	@keyframes ambient-float-three {
		0%, 100% { transform: translate3d(-10%, 4%, 0) scale(1); }
		50% { transform: translate3d(16%, -15%, 0) scale(1.15); }
	}

	@media (prefers-reduced-motion: reduce) {
		.ambient-background__orb {
			animation: none;
		}

		.ambient-background::after {
			background: transparent;
		}
	}
</style>
