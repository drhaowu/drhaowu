---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const archiveImage = `${base}assets/figma/complete-portfolio.png`;
---

<section class="figma-archive" id="archive" aria-labelledby="figma-archive-title">
	<div class="figma-archive__intro">
		<p class="figma-archive__eyebrow">Original Figma material</p>
		<h2 id="figma-archive-title">The full portfolio,<br /><em>kept in view.</em></h2>
		<p>
			The working board behind this site brings together the profile, three practice areas,
			project examples and the closing contact frame. It stays here as a visual archive of
			the original material.
		</p>
		<a href={archiveImage} target="_blank" rel="noreferrer">Open the complete Figma board image <span aria-hidden="true">↗</span></a>
	</div>

	<a class="figma-archive__frame" href={archiveImage} target="_blank" rel="noreferrer" aria-label="Open the complete portfolio board image">
		<img class="figma-archive__more" src={`${base}assets/figma/skills/more-icon.svg`} alt="" aria-hidden="true" />
		<img src={archiveImage} alt="Complete Dr Hao Wu portfolio board showing profile, skills, projects and contact material" loading="lazy" decoding="async" />
	</a>
</section>

<style>
	.figma-archive {
		position: relative;
		z-index: 1;
		scroll-margin-top: 6.5rem;
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
		width: min(100%, 72rem);
		margin: clamp(4rem, 10vw, 10rem) auto 0;
		padding: 0 clamp(0.25rem, 2vw, 1.5rem);
		text-align: center;
	}

	.figma-archive__intro {
		max-width: 42rem;
		margin: 0 auto;
	}

	.figma-archive__eyebrow {
		margin: 0 0 0.9rem;
		color: #6b7178;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.figma-archive h2 {
		margin: 0;
		font-size: clamp(2.2rem, 5vw, 5rem);
		font-weight: 700;
		letter-spacing: -0.075em;
		line-height: 0.92;
	}

	.figma-archive h2 em {
		color: #ff9a00;
		font-style: normal;
	}

	.figma-archive__intro > p:not(.figma-archive__eyebrow) {
		max-width: 37rem;
		margin: 1.4rem auto 0;
		color: #344054;
		font-size: 1rem;
		line-height: 1.6;
	}

	.figma-archive__intro > a {
		display: inline-flex;
		gap: 0.45rem;
		margin-top: 1.4rem;
		border-bottom: 1px solid currentColor;
		color: #171717;
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.65rem;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.figma-archive__frame {
		position: relative;
		display: flex;
		justify-content: center;
		width: min(100%, 34rem);
		max-height: 42rem;
		margin: 0 auto;
		overflow: hidden;
		border: 1px solid rgba(23, 23, 23, 0.12);
		border-radius: clamp(1rem, 2vw, 1.6rem);
		background: rgba(255, 255, 255, 0.66);
		box-shadow: 0 1.25rem 3rem rgba(34, 49, 68, 0.08);
	}

	.figma-archive__more {
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 1;
		width: 1.4rem;
		height: 1.4rem;
		padding: 0.2rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.82);
		box-shadow: 0 0.4rem 1rem rgba(34, 49, 68, 0.1);
	}

	.figma-archive__frame img:not(.figma-archive__more) {
		display: block;
		width: min(100%, 460px);
		height: auto;
	}

	.figma-archive__frame .figma-archive__more {
		display: block;
		width: 1.4rem;
		height: 1.4rem;
	}
</style>
