---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const avatarLogo = `${base}assets/images/hao/hao-wu-avatar-logo.png`;
---

<header class="portfolio-nav">
	<a class="portfolio-nav__brand" href={base} aria-label="Dr Hao Wu home">
		<span class="portfolio-nav__brand-avatar" aria-hidden="true">
			<img src={avatarLogo} alt="" width="64" height="64" />
		</span>
		<span>HAO WU</span>
	</a>
	<nav aria-label="Primary navigation">
		<a href={`${base}#research`}>Research</a>
		<a href={`${base}#hk-experience`}>Media</a>
		<a href={`${base}#visual-design-showcase`}>Design</a>
		<a href={`${base}#about`}>About</a>
	</nav>
</header>

<style>
	.portfolio-nav {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 1.65rem clamp(1.2rem, 5vw, 4rem);
		pointer-events: none;
		transition: opacity 220ms ease;
	}

	.portfolio-nav a {
		color: #294b82;
		text-decoration: none;
	}

	.portfolio-nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-body);
		font-size: clamp(0.84rem, 1.15vw, 1rem);
		font-weight: 600;
		letter-spacing: 0.08em;
		pointer-events: auto;
		white-space: nowrap;
	}

	.portfolio-nav__brand-avatar {
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		overflow: hidden;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.42);
	}

	.portfolio-nav__brand-avatar img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.portfolio-nav nav {
		display: flex;
		align-items: center;
		gap: clamp(0.8rem, 2.8vw, 2.4rem);
		margin-left: auto;
		font-family: var(--font-body);
		font-size: clamp(0.92rem, 1.45vw, 1.2rem);
		font-weight: 500;
		letter-spacing: 0.02em;
		pointer-events: auto;
	}

	.portfolio-nav nav a {
		opacity: 0.62;
		transition: opacity 180ms ease;
	}

	.portfolio-nav nav a:hover,
	.portfolio-nav nav a:focus-visible {
		opacity: 1;
	}

	@media (max-width: 560px) {
		.portfolio-nav {
			padding: 1.1rem 1rem;
		}

		.portfolio-nav nav {
			gap: 0.9rem;
			font-size: 0.8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portfolio-nav {
			transition: none;
		}
	}
</style>
