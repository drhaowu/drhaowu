---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="portfolio-nav">
	<a class="portfolio-nav__brand" href={base} aria-label="Dr Hao Wu home">
		<span class="portfolio-nav__brand-avatar" aria-hidden="true">
			<img src={`${base}assets/images/avatar.png`} alt="" width="64" height="64" />
		</span>
		<span>DR HAO WU</span>
	</a>
	<nav aria-label="Primary navigation">
		<a href={`${base}#about`}>About</a>
		<a href={`${base}#practices`}>Practices</a>
		<a href={`${base}#contact`}>Contact</a>
	</nav>
</header>

<style>
	.portfolio-nav {
		position: fixed;
		top: 1rem;
		left: 50%;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 2rem), 58rem);
		min-height: 3.7rem;
		padding: 0.55rem 0.65rem 0.55rem 1.15rem;
		border: 1px solid rgba(255, 255, 255, 0.68);
		border-radius: 999px;
		background: linear-gradient(105deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.28));
		box-shadow: 0 1rem 2.8rem rgba(34, 49, 68, 0.1), inset 0 1px rgba(255, 255, 255, 0.86), inset 0 -1px rgba(255, 255, 255, 0.24);
		backdrop-filter: blur(26px) saturate(155%);
		-webkit-backdrop-filter: blur(26px) saturate(155%);
		transform: translateX(-50%);
		transition: box-shadow 220ms ease, background 220ms ease, border-color 220ms ease;
	}

	.portfolio-nav::before {
		position: absolute;
		inset: 1px 12% auto;
		height: 1px;
		border-radius: inherit;
		background: rgba(255, 255, 255, 0.8);
		content: '';
		pointer-events: none;
	}

	.portfolio-nav a {
		color: #171717;
		text-decoration: none;
	}

	.portfolio-nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		white-space: nowrap;
	}

	.portfolio-nav__brand-avatar {
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		overflow: hidden;
		border-radius: 50%;
		border: 1px solid rgba(23, 23, 23, 0.16);
		background: rgba(255, 255, 255, 0.45);
		box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.32);
	}

	.portfolio-nav__brand-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.portfolio-nav nav {
		display: flex;
		align-items: center;
		gap: clamp(0.8rem, 2.8vw, 2.4rem);
		font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
	}

	.portfolio-nav nav a {
		opacity: 0.62;
		transition: opacity 180ms ease;
	}

	.portfolio-nav nav a:hover,
	.portfolio-nav nav a:focus-visible {
		opacity: 1;
	}

	.portfolio-nav:hover,
	.portfolio-nav:focus-within {
		border-color: rgba(255, 255, 255, 0.9);
		background: linear-gradient(105deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.34));
		box-shadow: 0 1.15rem 3.2rem rgba(34, 49, 68, 0.14), inset 0 1px rgba(255, 255, 255, 0.92), inset 0 -1px rgba(255, 255, 255, 0.28);
	}

	@media (max-width: 560px) {
		.portfolio-nav {
			top: 0.65rem;
			width: calc(100% - 1.25rem);
			min-height: 3.35rem;
			padding-left: 0.95rem;
		}

		.portfolio-nav__brand {
			font-size: 0.64rem;
			letter-spacing: 0.11em;
		}

		.portfolio-nav nav {
			gap: 0.72rem;
			font-size: 0.58rem;
		}

		.portfolio-nav nav {
			gap: 0.52rem;
			font-size: 0.55rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portfolio-nav {
			transition: none;
		}
	}
</style>
