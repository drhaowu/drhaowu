---
import FigmaSkills from './FigmaSkills.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assets = `${base}assets/figma/skills/`;
const imageBase = `${base}assets/images/`;

const workItems = [
	{
		tag: '01 / Visual Design',
		title: 'Designing for more than one screen',
		copy: 'Platform-adaptive visuals that move between social media, long-form graphics, websites and H5 campaigns.',
		image: `${assets}visual-design.png`,
		alt: 'A collage of visual design examples',
		className: 'work-card--wide',
	},
	{
		tag: '02 / Video Production',
		title: 'Knowledge-driven short videos',
		copy: 'Turning research, travel and everyday questions into clear, engaging stories.',
		image: `${assets}video-production.png`,
		alt: 'A knowledge-driven short video example',
		className: 'work-card--video',
	},
	{
		tag: '03 / Media + Research',
		title: 'The Hong Kong Experience Project',
		copy: 'Media practice as a way to make cultural research accessible, public and memorable.',
		image: `${assets}media-research.png`,
		alt: 'The Hong Kong Experience Project cover',
		className: 'work-card--research',
	},
];
---

<div class="portfolio-site">
	<header class="site-nav">
		<a class="site-nav__brand" href="#top" aria-label="Dr Hao Wu home">DR HAO WU</a>
		<nav aria-label="Primary navigation">
			<a href="#about">About</a>
			<a href="#skills">Skills</a>
			<a href="#work">Work</a>
			<a class="site-nav__contact" href="#contact">Contact <span aria-hidden="true">↗</span></a>
		</nav>
	</header>

	<main id="top">
		<section class="hero" id="about" aria-labelledby="hero-title">
			<div class="hero__copy">
				<div class="hello-pill">Hello! <span aria-hidden="true">⌁</span></div>
				<h1 id="hero-title">I’m Dr. <em>Hao Wu</em>,<br />Digital Media Creator<br class="hero__desktop-break" /> and Researcher</h1>
				<div class="hero__accent" aria-hidden="true">⌁</div>
			</div>

			<div class="hero__portrait" aria-label="Portrait of Dr Hao Wu">
				<div class="hero__sun" aria-hidden="true"></div>
				<img src={`${imageBase}profile-photo.png`} alt="Dr Hao Wu" width="680" height="681" />
			</div>

			<aside class="hero__quote">
				<span class="quote-mark" aria-hidden="true">“</span>
				<p>Hao’s creative approach bridges <strong>theory and practice</strong>, supporting inclusive learning and fostering cross-cultural understanding through digital storytelling.</p>
				<p class="hero__quote-zh">吴豪一直致力于将理论与实践结合起来，通过媒体叙事的方法支持课堂中的包容性学习，以及跨文化理解。</p>
			</aside>

			<div class="hero__experience">
				<strong>6 Years</strong>
				<span>Media Industry<br />Experience</span>
			</div>

			<a class="scroll-cue" href="#skills" aria-label="Scroll to skills">↓</a>
		</section>

		<section class="skills-wrap" id="skills" aria-label="Core skills">
			<FigmaSkills />
		</section>

		<section class="work-section" id="work" aria-labelledby="work-title">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Selected work</p>
					<h2 id="work-title">Ideas become public<br /><em>through practice.</em></h2>
				</div>
				<p class="section-intro">A working archive of visual design, video production and research-led media experiments.</p>
			</div>

			<div class="work-grid">
				{workItems.map((item) => (
					<article class={`work-card ${item.className}`}>
						<div class="work-card__meta">
							<span>{item.tag}</span>
							<span aria-hidden="true">↗</span>
						</div>
						<div class="work-card__body">
							<h3>{item.title}</h3>
							<p>{item.copy}</p>
						</div>
						<div class="work-card__image">
							<img src={item.image} alt={item.alt} loading="lazy" decoding="async" />
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="practice-section" aria-labelledby="practice-title">
			<div class="practice-section__shape" aria-hidden="true"></div>
			<div class="practice-section__copy">
				<p class="section-kicker">A practice in progress</p>
				<h2 id="practice-title">Research is not<br /><em>just behind the work.</em></h2>
				<p>It is part of how the work is made: asking better questions, listening across cultures and finding forms that invite people in.</p>
				<a class="text-link" href="#contact">Let’s work together <span aria-hidden="true">↗</span></a>
			</div>
			<div class="practice-section__stats">
				<div><strong>6</strong><span>years in<br />media</span></div>
				<div><strong>3</strong><span>connected<br />practices</span></div>
				<div><strong>1</strong><span>curious<br />question</span></div>
			</div>
		</section>

		<section class="end-section" id="contact" aria-labelledby="end-title">
			<div class="end-section__copy">
				<div class="hello-pill hello-pill--end">The End <span aria-hidden="true">⌁</span></div>
				<h2 id="end-title">Thank you for reviewing<br /><em>my portfolio.</em></h2>
				<div class="end-section__accent" aria-hidden="true">⌁</div>
			</div>
			<div class="end-section__contact">
				<span class="quote-mark" aria-hidden="true">“</span>
				<p class="section-kicker">Contact</p>
				<a href="mailto:ucfawuc@ucl.ac.uk">ucfawuc@ucl.ac.uk</a>
			</div>
			<div class="end-section__sun" aria-hidden="true"></div>
			<img class="end-section__portrait" src={`${imageBase}profile-photo.png`} alt="" width="680" height="681" />
		</section>
	</main>
</div>

<style>
	.portfolio-site {
		--ink: #171717;
		--body: #344054;
		--orange: #ff9a00;
		--soft-orange: #ffb273;
		--paper: #f7f7f4;
		background: #fff;
		color: var(--ink);
		font-family: OPPOSans, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	.site-nav {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem clamp(1.25rem, 4.3vw, 5rem);
		border-bottom: 1px solid rgba(23, 23, 23, 0.08);
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(16px);
	}

	.site-nav a {
		color: inherit;
		text-decoration: none;
	}

	.site-nav__brand {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.site-nav nav {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 3.5rem);
		font-size: 0.82rem;
	}

	.site-nav nav a {
		opacity: 0.68;
		transition: opacity 180ms ease;
	}

	.site-nav nav a:hover,
	.site-nav nav a:focus-visible {
		opacity: 1;
	}

	.site-nav__contact {
		opacity: 1 !important;
		padding: 0.65rem 1rem;
		border-radius: 999px;
		background: var(--orange);
		color: #fff !important;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
		align-items: center;
		min-height: min(900px, calc(100svh - 4.25rem));
		padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 8.5rem) clamp(6rem, 10vw, 10rem);
		gap: clamp(1rem, 3vw, 4rem);
		overflow: hidden;
	}

	.hero__copy {
		position: relative;
		z-index: 2;
		max-width: 790px;
	}

	.hello-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 1.25rem;
		border: 1px solid var(--ink);
		border-radius: 999px;
		font-size: 0.95rem;
		line-height: 1;
	}

	.hello-pill span {
		color: var(--orange);
		font-size: 1.35rem;
		line-height: 0.5;
		transform: rotate(-18deg);
	}

	.hero h1,
	.end-section h2 {
		margin: 1.25rem 0 0;
		font-size: clamp(3.15rem, 6.15vw, 7.25rem);
		font-weight: 700;
		line-height: 0.97;
		letter-spacing: -0.07em;
}

	.hero h1 em,
	.end-section h2 em,
	.section-heading em,
	.practice-section h2 em {
		color: var(--orange);
		font-style: normal;
	}

	.hero__accent,
	.end-section__accent {
		margin: 0.5rem 0 0 0.5rem;
		color: var(--soft-orange);
		font-size: 5.5rem;
		line-height: 0.25;
		transform: rotate(-18deg);
	}

	.hero__portrait {
		position: relative;
		align-self: end;
		justify-self: center;
		width: min(100%, 540px);
		aspect-ratio: 1 / 1;
		margin-top: 4rem;
	}

	.hero__sun,
	.end-section__sun {
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 76%;
		aspect-ratio: 2 / 1;
		border-radius: 999px 999px 0 0;
		background: var(--soft-orange);
		transform: translateX(-50%);
	}

	.hero__portrait img {
		position: absolute;
		bottom: 0;
		left: 50%;
		z-index: 1;
		width: 78%;
		height: 100%;
		object-fit: contain;
		object-position: bottom center;
		transform: translateX(-50%);
	}

	.hero__quote {
		position: absolute;
		bottom: 8%;
		left: clamp(1.25rem, 4vw, 4.5rem);
		width: min(30rem, 31vw);
		color: var(--body);
		font-size: clamp(0.78rem, 1vw, 1.2rem);
		line-height: 1.35;
	}

	.hero__quote p {
		margin: 0;
	}

	.hero__quote strong {
		color: #ff7262;
	}

	.quote-mark {
		display: block;
		margin-bottom: 0.25rem;
		font-size: 2.6rem;
		font-weight: 700;
		line-height: 0.65;
	}

	.hero__quote-zh {
		margin-top: 1rem !important;
		font-size: 0.86em;
	}

	.hero__experience {
		position: absolute;
		right: clamp(1.25rem, 5vw, 6rem);
		bottom: 22%;
		display: grid;
		gap: 0.1rem;
		text-align: center;
		color: var(--body);
	}

	.hero__experience strong {
		color: var(--orange);
		font-size: clamp(1.3rem, 2vw, 2.8rem);
		line-height: 1;
	}

	.hero__experience span {
		font-size: clamp(0.6rem, 0.72vw, 0.9rem);
		line-height: 1.3;
	}

	.scroll-cue {
		position: absolute;
		right: clamp(1.25rem, 4vw, 4.5rem);
		bottom: 4rem;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--orange);
		color: #fff;
		font-size: 1.4rem;
		text-decoration: none;
	}

	.skills-wrap {
		border-top: 1px solid rgba(23, 23, 23, 0.05);
	}

	.skills-wrap :global(.skills-page) {
		min-height: auto;
		padding-top: clamp(4rem, 7vw, 7rem);
		padding-bottom: clamp(5rem, 9vw, 9rem);
	}

	.work-section {
		padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 8.5rem);
		background: var(--paper);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		max-width: 1240px;
		margin: 0 auto clamp(2.5rem, 5vw, 5rem);
	}

	.section-kicker {
		margin: 0 0 1rem;
		color: var(--orange);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.section-heading h2,
	.practice-section h2 {
		margin: 0;
		font-size: clamp(2.5rem, 5vw, 5.5rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: -0.065em;
	}

	.section-intro {
		max-width: 20rem;
		margin: 0 0 0.4rem;
		color: var(--body);
		font-size: 1rem;
		line-height: 1.5;
	}

	.work-grid {
		display: grid;
		grid-template-columns: 1.22fr 0.78fr;
		grid-template-rows: auto auto;
		gap: clamp(1rem, 2vw, 2rem);
		max-width: 1240px;
		margin: 0 auto;
	}

	.work-card {
		position: relative;
		display: flex;
		min-height: 31rem;
		flex-direction: column;
		overflow: hidden;
		border-radius: 1.5rem;
		background: #fff;
		box-shadow: 0 1rem 3rem rgba(23, 23, 23, 0.06);
	}

	.work-card--wide {
		grid-row: span 2;
		min-height: 44rem;
	}

	.work-card__meta {
		display: flex;
		justify-content: space-between;
		padding: 1.35rem 1.5rem 0;
		color: var(--body);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.work-card__body {
		padding: 1rem 1.5rem 1.5rem;
	}

	.work-card__body h3 {
		max-width: 18ch;
		margin: 0;
		font-size: clamp(1.35rem, 2.2vw, 2.3rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.work-card__body p {
		max-width: 35ch;
		margin: 0.8rem 0 0;
		color: var(--body);
		font-size: 0.92rem;
		line-height: 1.45;
	}

	.work-card__image {
		position: relative;
		flex: 1;
		min-height: 14rem;
		margin: auto 1rem 1rem;
		overflow: hidden;
		border-radius: 1rem;
		background: #eee;
	}

	.work-card__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work-card--video .work-card__image img {
		object-position: center 28%;
	}

	.work-card--research .work-card__image img {
		object-position: center;
	}

	.practice-section {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
		align-items: center;
		min-height: 42rem;
		padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 7vw, 8.5rem);
		overflow: hidden;
		background: #fff;
	}

	.practice-section__copy {
		position: relative;
		z-index: 1;
		max-width: 40rem;
	}

	.practice-section__copy > p:not(.section-kicker) {
		max-width: 29rem;
		margin: 2rem 0 0;
		color: var(--body);
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.practice-section__shape {
		position: absolute;
		right: -10%;
		bottom: -30%;
		width: min(65vw, 760px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: #ffb273;
		opacity: 0.9;
	}

	.practice-section__stats {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		padding: 2rem;
		border: 1px solid rgba(23, 23, 23, 0.1);
		border-radius: 1.5rem;
		background: rgba(255, 255, 255, 0.65);
		backdrop-filter: blur(12px);
	}

	.practice-section__stats div {
		display: grid;
		gap: 0.4rem;
	}

	.practice-section__stats strong {
		font-size: clamp(2.5rem, 4vw, 4.5rem);
		line-height: 0.9;
	}

	.practice-section__stats span {
		color: var(--body);
		font-size: 0.8rem;
		line-height: 1.2;
	}

	.text-link {
		display: inline-flex;
		gap: 0.6rem;
		margin-top: 2rem;
		border-bottom: 1px solid var(--ink);
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
	}

	.end-section {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		min-height: 56rem;
		padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 7vw, 8.5rem);
		overflow: hidden;
		background: var(--paper);
	}

	.end-section__copy {
		position: relative;
		z-index: 2;
	}

	.hello-pill--end {
		background: #fff;
	}

	.end-section h2 {
		max-width: 12ch;
		font-size: clamp(3rem, 6vw, 6.8rem);
	}

	.end-section__contact {
		position: relative;
		z-index: 2;
		align-self: end;
		max-width: 20rem;
		padding-bottom: 2rem;
		color: var(--body);
	}

	.end-section__contact .quote-mark {
		color: var(--body);
	}

	.end-section__contact .section-kicker {
		margin: 0.5rem 0 0.4rem;
	}

	.end-section__contact a {
		color: var(--body);
		font-size: clamp(1.2rem, 2vw, 2rem);
		text-decoration: none;
	}

	.end-section__sun {
		bottom: -2%;
		left: 63%;
		width: min(48vw, 620px);
	}

	.end-section__portrait {
		position: absolute;
		bottom: 0;
		left: 63%;
		z-index: 1;
		width: min(40vw, 500px);
		height: auto;
		transform: translateX(-50%);
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-top: 4rem;
		}

		.hero__copy {
			max-width: 42rem;
			margin: 0 auto;
			text-align: center;
		}

		.hero__accent {
			margin-left: 0;
		}

		.hero__portrait {
			width: min(100%, 440px);
			margin-top: 2rem;
		}

		.hero__quote {
			position: relative;
			bottom: auto;
			left: auto;
			width: min(100%, 34rem);
			margin: 1rem auto 0;
		}

		.hero__experience {
			right: 1.5rem;
			bottom: 34%;
		}

		.section-heading {
			align-items: start;
			flex-direction: column;
		}

		.end-section {
			grid-template-columns: 1fr;
			min-height: 50rem;
		}

		.end-section__contact {
			align-self: start;
			margin-top: 4rem;
		}
	}

	@media (max-width: 640px) {
		.site-nav {
			align-items: start;
			gap: 1rem;
		}

		.site-nav nav {
			gap: 0.8rem;
			font-size: 0.72rem;
		}

		.site-nav nav a:nth-child(-n + 2) {
			display: none;
		}

		.hero h1,
		.end-section h2 {
			font-size: clamp(2.8rem, 13vw, 4.6rem);
		}

		.hero__desktop-break {
			display: none;
		}

		.hero__experience {
			right: 0.5rem;
			bottom: 32%;
		}

		.hero__experience strong {
			font-size: 1.3rem;
		}

		.hero__experience span {
			font-size: 0.58rem;
		}

		.work-grid {
			grid-template-columns: 1fr;
		}

		.work-card,
		.work-card--wide {
			grid-row: auto;
			min-height: 30rem;
		}

		.practice-section {
			grid-template-columns: 1fr;
			min-height: 48rem;
		}

		.practice-section__stats {
			margin-top: 4rem;
			padding: 1.2rem;
		}

		.end-section__sun {
			left: 55%;
			width: 110vw;
		}

		.end-section__portrait {
			left: 55%;
			width: 82vw;
		}
	}
</style>
