---
interface Props {
	base: string;
}

const { base } = Astro.props;
---

<section class="publication-shelf" id="research" aria-labelledby="publication-shelf-title">
	<div class="publication-shelf__inner">
		<div class="publication-shelf__identity" aria-labelledby="research-identity-title">
			<span class="publication-shelf__quote" aria-hidden="true">“</span>
			<h2 id="research-identity-title">
				Digital geography is really about <em>people</em>, place and public life.
			</h2>
			<div class="publication-shelf__identity-credit">
				<strong>Dr Hao Wu</strong>
				<span>Digital Geographer · Researcher · Media Creator</span>
			</div>
		</div>

		<div class="publication-shelf__heading">
			<h2 id="publication-shelf-title"><span>Research</span><br /><em>On The Page.</em></h2>
		</div>

		<div class="publication-shelf__triangle" aria-label="Hao Wu's research, editorial and public-facing work">
			<a
				class="publication-shelf__object publication-shelf__object--article"
				href="https://doi.org/10.1002/berj.70215"
				target="_blank"
				rel="noreferrer"
				aria-label="Read The doctoral journey as decolonial praxis: Self-formation of Global South students in UK higher education"
			>
				<span class="publication-shelf__frame publication-shelf__frame--article">
					<img
src={`${base}assets/papers/doctoral-journey-decolonial-praxis-cover.png`}
						alt="First page of The doctoral journey as decolonial praxis: Self-formation of Global South students in UK higher education"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span class="publication-shelf__hover-label" aria-hidden="true"><strong>Published<br />Article</strong></span>
			</a>

			<a
				class="publication-shelf__object publication-shelf__object--journal"
				href="https://www.sciencedirect.com/journal/digital-geography-and-society"
				target="_blank"
				rel="noreferrer"
				aria-label="Digital Geography and Society — Early Career Editorial Board"
			>
				<span class="publication-shelf__frame publication-shelf__frame--journal">
					<img
src={`${base}assets/papers/digital-geography-and-society-cover.png`}
						alt="Digital Geography and Society journal cover"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span class="publication-shelf__hover-label" aria-hidden="true"><strong>Early Career<br />Editorial Board</strong></span>
			</a>

			<a
				class="publication-shelf__object publication-shelf__object--public"
				href="#media-research"
				aria-label="Research in public through media and cultural storytelling"
			>
				<span class="publication-shelf__frame publication-shelf__frame--public">
					<img
src={`${base}assets/figma/skills/media-research.png`}
						alt="Research-led media and cultural storytelling project"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span class="publication-shelf__hover-label" aria-hidden="true"><strong>Research<br />in public</strong></span>
			</a>
		</div>

		<div class="publication-shelf__details">
			<h3>The doctoral journey<br /><em>as decolonial praxis.</em></h3>
			<span class="publication-shelf__sr-only">Self-formation of Global South students in UK higher education.</span>
		</div>
	</div>
</section>

<style>
	.publication-shelf {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 7vw, 8.5rem) clamp(6rem, 11vw, 11rem);
		overflow: hidden;
		background: linear-gradient(145deg, rgba(225, 239, 255, 0.46), rgba(255, 255, 255, 0.16) 54%, rgba(195, 215, 255, 0.28));
		scroll-margin-top: 5rem;
	}

	.publication-shelf__inner {
		width: min(100%, 90rem);
		margin: 0 auto;
	}

	.publication-shelf__identity {
		max-width: 74rem;
		margin: 0 auto clamp(6rem, 12vw, 11rem);
		text-align: center;
	}

	.publication-shelf__quote {
		display: block;
		height: 3.5rem;
		color: #687dff;
		font-family: Georgia, serif;
		font-size: clamp(5rem, 9vw, 9rem);
		line-height: 0.72;
	}

	.publication-shelf__identity h2 {
		margin: 0;
		color: #171717;
		font-family: var(--font-display);
		font-size: clamp(3rem, 6.6vw, 6.9rem);
		font-weight: 800;
		letter-spacing: -0.095em;
		line-height: 0.9;
	}

	.publication-shelf__identity h2 em {
		background: linear-gradient(110deg, #1769e8 5%, #42b9ef 52%, #727bff 95%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-style: normal;
	}

	.publication-shelf__identity-credit {
		display: grid;
		gap: 0.5rem;
		margin-top: 2.5rem;
		color: #344d70;
	}

	.publication-shelf__identity-credit strong {
		color: #1769e8;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 1.8vw, 1.65rem);
		font-style: italic;
		letter-spacing: -0.04em;
	}

	.publication-shelf__identity-credit span {
		font-family: var(--font-body);
		font-size: clamp(0.78rem, 1vw, 0.95rem);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.publication-shelf__heading {
		max-width: 52rem;
		margin: 0 auto;
		text-align: center;
	}

	.publication-shelf__heading h2 {
		margin: 0;
		color: #171717;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 11vw, 10rem);
		font-weight: 800;
		letter-spacing: -0.105em;
		line-height: 0.82;
	}

	.publication-shelf__heading h2 em {
		background: linear-gradient(110deg, #1769e8 5%, #42b9ef 52%, #727bff 95%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-style: normal;
	}

	.publication-shelf__triangle {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: end;
		width: min(100%, 72rem);
		margin: clamp(4rem, 8vw, 8rem) auto 0;
	}

	.publication-shelf__object {
		position: relative;
		display: block;
		width: min(100%, 23rem);
		color: inherit;
		text-decoration: none;
		transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.publication-shelf__object--article {
		grid-column: 1 / -1;
		justify-self: center;
		width: min(100%, 25rem);
		z-index: 3;
	}

	.publication-shelf__object--journal {
		justify-self: end;
		margin-top: -3.7rem;
		transform: translateX(1rem) rotate(-8deg);
		z-index: 2;
	}

	.publication-shelf__object--public {
		justify-self: start;
		margin-top: -3.7rem;
		transform: translateX(-1rem) rotate(8deg);
		z-index: 2;
	}

	.publication-shelf__object--article:hover,
	.publication-shelf__object--article:focus-visible {
		transform: translateY(-0.7rem) rotate(1deg);
	}

	.publication-shelf__object--journal:hover,
	.publication-shelf__object--journal:focus-visible {
		transform: translate(1rem, -0.7rem) rotate(-3deg);
	}

	.publication-shelf__object--public:hover,
	.publication-shelf__object--public:focus-visible {
		transform: translate(-1rem, -0.7rem) rotate(3deg);
	}

	.publication-shelf__frame {
		position: relative;
		display: block;
		overflow: hidden;
		background: #fff;
		box-shadow: 1.3rem 1.5rem 2.2rem rgba(38, 82, 148, 0.18), -0.35rem 0 0 rgba(218, 229, 242, 0.8);
	}

	.publication-shelf__frame--article {
		aspect-ratio: 484.724 / 697.323;
	}

	.publication-shelf__frame--journal {
		aspect-ratio: 3 / 4;
	}

	.publication-shelf__frame--public {
		aspect-ratio: 4 / 3;
	}

	.publication-shelf__frame::after {
		position: absolute;
		inset: 0;
		border: 0.55rem solid rgba(255, 255, 255, 0.26);
		content: '';
		pointer-events: none;
	}

	.publication-shelf__frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.publication-shelf__hover-label {
		position: absolute;
		top: 8%;
		right: -12%;
		z-index: 4;
		display: block;
		padding: 1rem 1.25rem;
		border-radius: 999px;
		background: #fbfcf5;
		box-shadow: 0.4rem 0.7rem 1.3rem rgba(36, 68, 125, 0.2);
		color: #1d2b54;
		font-family: var(--font-display);
		font-size: clamp(1rem, 1.7vw, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 0.9;
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.8rem) rotate(3deg);
		transition: opacity 260ms ease, transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.publication-shelf__object--public .publication-shelf__hover-label {
		right: auto;
		left: -12%;
		transform: translateY(0.8rem) rotate(-3deg);
	}

	.publication-shelf__object:hover .publication-shelf__hover-label,
	.publication-shelf__object:focus-visible .publication-shelf__hover-label {
		opacity: 1;
		transform: translateY(0) rotate(3deg);
	}

	.publication-shelf__object--public:hover .publication-shelf__hover-label,
	.publication-shelf__object--public:focus-visible .publication-shelf__hover-label {
		transform: translateY(0) rotate(-3deg);
	}

	.publication-shelf__details {
		max-width: 64rem;
		margin: clamp(4rem, 7vw, 7rem) auto 0;
		text-align: center;
	}

	.publication-shelf__details h3 {
		margin: 0;
		color: #171717;
		font-family: var(--font-display);
		font-size: clamp(2.8rem, 6vw, 6rem);
		font-weight: 800;
		letter-spacing: -0.085em;
		line-height: 0.88;
	}

	.publication-shelf__details h3 em {
		color: #1769e8;
		font-style: normal;
	}

	.publication-shelf__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 700px) {
		.publication-shelf__triangle {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.publication-shelf__object--article {
			grid-column: auto;
			width: min(82%, 23rem);
		}

		.publication-shelf__object--journal,
		.publication-shelf__object--public {
			justify-self: center;
			margin-top: 0;
			transform: none;
		}

		.publication-shelf__object--journal:hover,
		.publication-shelf__object--journal:focus-visible,
		.publication-shelf__object--public:hover,
		.publication-shelf__object--public:focus-visible {
			transform: translateY(-0.6rem) rotate(2deg);
		}

		.publication-shelf__object--public:hover .publication-shelf__hover-label,
		.publication-shelf__object--public:focus-visible .publication-shelf__hover-label {
			transform: translateY(0) rotate(3deg);
		}

		.publication-shelf__hover-label {
			right: -4%;
		}

		.publication-shelf__object--public .publication-shelf__hover-label {
			right: -4%;
			left: auto;
		}
	}

	@media (max-width: 560px) {
		.publication-shelf {
			padding-right: 1rem;
			padding-left: 1rem;
		}

		.publication-shelf__identity h2 {
			font-size: clamp(2.8rem, 11vw, 4rem);
		}

		.publication-shelf__identity-credit {
			margin-top: 2rem;
		}

		.publication-shelf__identity-credit span {
			font-size: 0.68rem;
			letter-spacing: 0.04em;
		}

		.publication-shelf__heading h2 {
			font-size: clamp(4.2rem, 19vw, 7rem);
		}

		.publication-shelf__object--article {
			width: min(88%, 20rem);
		}

		.publication-shelf__details h3 {
			font-size: clamp(2.25rem, 10vw, 3.7rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.publication-shelf__object,
		.publication-shelf__hover-label {
			transition: none;
		}
	}
</style>
