---
interface Props {
	base: string;
}

const { base } = Astro.props;
---

<section class="publication-shelf" id="research" aria-labelledby="publication-shelf-title">
	<div class="publication-shelf__inner">
		<div class="publication-shelf__heading">
			<h2 id="publication-shelf-title"><span>Research</span><br /><em>On The Page.</em></h2>
		</div>

		<div class="publication-shelf__triangle" aria-label="Hao Wu's research, editorial and public-facing work">
			<a
				class="publication-shelf__object publication-shelf__object--article"
				href="https://doi.org/10.1002/berj.70215"
				target="_blank"
				rel="noreferrer"
				aria-label="Read The doctoral journey as decolonial praxis: Self-formation of Global South students in UK higher education"
			>
				<span class="publication-shelf__frame publication-shelf__frame--article">
					<img
						src={`${base}assets/papers/doctoral-journey-decolonial-praxis-cover.png`}
						alt="First page of The doctoral journey as decolonial praxis: Self-formation of Global South students in UK higher education"
						width="808"
						height="1163"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span class="publication-shelf__hover-label" aria-hidden="true"><strong>Published<br />Article</strong></span>
			</a>

			<a
				class="publication-shelf__object publication-shelf__object--journal"
				href="https://www.sciencedirect.com/journal/digital-geography-and-society"
				target="_blank"
				rel="noreferrer"
				aria-label="Digital Geography and Society — Early Career Editorial Board"
			>
				<span class="publication-shelf__accept-character" aria-hidden="true">
					<img
						src={`${base}assets/images/hao/hao-wu-avatar-accept.png`}
					alt=""
					width="1024"
						height="1536"
						loading="lazy"
						decoding="async"
					/>
					<span class="publication-shelf__accept-sign"><span aria-hidden="true">✓</span><strong>Accept</strong></span>
				</span>
				<span class="publication-shelf__frame publication-shelf__frame--journal">
					<img
src={`${base}assets/papers/digital-geography-and-society-cover.png`}
						alt="Digital Geography and Society journal cover"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span class="publication-shelf__hover-label" aria-hidden="true"><strong>Early Career<br />Editorial Board</strong></span>
			</a>

			<a
				class="publication-shelf__object publication-shelf__object--public"
				href="https://www.ucl.ac.uk/social-historical-sciences/news/2024/jun/exploring-hybrid-queer-spaces-china-study-hao-wu"
				target="_blank"
				rel="noreferrer"
				aria-label="Read UCL's article about Hao Wu's research on hybrid queer spaces in China"
			>
				<span class="publication-shelf__frame publication-shelf__frame--public">
					<img
						src={`${base}assets/projects/research/ucl-hybrid-queer-spaces.png`}
						alt="UCL research news article about Hao Wu's study of hybrid queer spaces in China"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<span class="publication-shelf__hover-label" aria-hidden="true"><strong>UCL Research<br />News</strong></span>
			</a>
		</div>

	</div>
</section>

<style>
	.publication-shelf {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: var(--section-space) clamp(1.25rem, 7vw, 8.5rem);
		overflow: hidden;
		background: transparent;
		scroll-margin-top: 5rem;
	}

	.publication-shelf__inner {
		width: min(100%, 90rem);
		margin: 0 auto;
	}

	.publication-shelf__heading {
		max-width: 52rem;
		margin: 0 auto;
		text-align: center;
	}

	.publication-shelf__heading h2 {
		margin: 0;
		color: #171717;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 11vw, 10rem);
		font-weight: 800;
		letter-spacing: -0.105em;
		line-height: 0.82;
	}

	.publication-shelf__heading h2 em {
		background: linear-gradient(110deg, #1769e8 5%, #42b9ef 52%, #727bff 95%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-style: normal;
	}

	.publication-shelf__triangle {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		width: min(100%, 66rem);
		min-height: clamp(35rem, 51vw, 47rem);
		margin: clamp(3.5rem, 6vw, 6rem) auto 0;
	}

	.publication-shelf__object {
		position: relative;
		display: block;
		width: min(100%, 23rem);
		color: inherit;
		text-decoration: none;
		transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.publication-shelf__object--article {
		grid-column: 1 / -1;
		grid-row: 1;
		justify-self: center;
		width: min(100%, 25rem);
		transform: translateY(3.6rem);
		z-index: 5;
	}

	.publication-shelf__object--journal {
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		width: min(100%, 25rem);
		margin-top: clamp(7rem, 10vw, 9rem);
		transform: translateX(-3.2rem) rotate(-8deg);
		z-index: 2;
	}

	.publication-shelf__object--public {
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
		width: min(100%, 25rem);
		margin-top: clamp(7rem, 10vw, 9rem);
		transform: translateX(3.2rem) rotate(8deg);
		z-index: 2;
	}

	.publication-shelf__object--article:hover,
	.publication-shelf__object--article:focus-visible {
		transform: translateY(2.9rem) rotate(1deg);
	}

	.publication-shelf__object--journal:hover,
	.publication-shelf__object--journal:focus-visible {
		transform: translate(-3.2rem, -0.7rem) rotate(-5deg);
	}

	.publication-shelf__object--public:hover,
	.publication-shelf__object--public:focus-visible {
		transform: translate(3.2rem, -0.7rem) rotate(5deg);
	}

	.publication-shelf__frame {
		position: relative;
		z-index: 2;
		display: block;
		overflow: hidden;
		background: #fff;
		box-shadow: 1.3rem 1.5rem 2.2rem rgba(38, 82, 148, 0.18), -0.35rem 0 0 rgba(218, 229, 242, 0.8);
	}

	.publication-shelf__accept-character {
		position: absolute;
		bottom: 80%;
		left: 20%;
		z-index: 3;
		display: block;
		width: clamp(8rem, 13vw, 11rem);
		aspect-ratio: 2 / 3;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 1.8rem) scale(0.94);
		transform-origin: 50% 100%;
		transition: opacity 180ms ease, transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.publication-shelf__accept-character img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		clip-path: inset(0 0 34% 0);
	}

	.publication-shelf__accept-sign {
		position: absolute;
		top: 52%;
		left: 15%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.34rem;
		width: 61%;
		height: 22%;
		color: #1769e8;
		font-family: var(--font-display);
		font-size: clamp(0.72rem, 1.15vw, 1rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		text-shadow: 0 0.05rem 0 rgba(255, 255, 255, 0.8);
	}

	.publication-shelf__accept-sign > span {
		font-family: ui-sans-serif, system-ui, sans-serif;
		font-size: 1.05em;
		font-weight: 900;
	}

	.publication-shelf__object--journal:hover .publication-shelf__accept-character,
	.publication-shelf__object--journal:focus .publication-shelf__accept-character,
	.publication-shelf__object--journal:focus-visible .publication-shelf__accept-character {
		opacity: 1;
		transform: translate(-50%, 0) scale(1);
	}

	.publication-shelf__object--journal:hover,
	.publication-shelf__object--journal:focus,
	.publication-shelf__object--journal:focus-visible {
		z-index: 5;
	}

	.publication-shelf__frame--article,
	.publication-shelf__frame--journal,
	.publication-shelf__frame--public {
		/* Match all three research cards without cropping their source images. */
		aspect-ratio: 808 / 1163;
	}

	.publication-shelf__television {
		position: relative;
		display: block;
		padding: 0.9rem 0.9rem 1.4rem;
		border-radius: 1.8rem 1.8rem 1.2rem 1.2rem;
		background: linear-gradient(145deg, #e8f1ff, #9bbdff 52%, #6e84f3);
		box-shadow: 1.2rem 1.5rem 2.1rem rgba(38, 82, 148, 0.2), inset 0.2rem 0.2rem 0.35rem rgba(255, 255, 255, 0.75);
		color: inherit;
		text-decoration: none;
	}

	.publication-shelf__tv-antenna {
		position: absolute;
		top: -1.25rem;
		left: 50%;
		width: 3.8rem;
		height: 1.5rem;
		border-top: 0.18rem solid #6078d8;
		transform: translateX(-50%);
	}

	.publication-shelf__tv-antenna::before,
	.publication-shelf__tv-antenna::after {
		position: absolute;
		top: -0.45rem;
		width: 0.18rem;
		height: 1rem;
		border-radius: 999px;
		background: #6078d8;
		content: '';
	}

	.publication-shelf__tv-antenna::before {
		left: 0.2rem;
		transform: rotate(-35deg);
	}

	.publication-shelf__tv-antenna::after {
		right: 0.2rem;
		transform: rotate(35deg);
	}

	.publication-shelf__tv-body {
		display: block;
		padding: 0.62rem 0.62rem 0.5rem;
		border-radius: 1.2rem;
		background: linear-gradient(145deg, #f8fbff, #c1d4ff);
	}

	.publication-shelf__tv-screen {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: 0.85rem;
		background: #17243f;
		box-shadow: inset 0 0 0 0.2rem rgba(24, 45, 89, 0.5), inset 0 0.35rem 1rem rgba(0, 0, 0, 0.22);
	}

	.publication-shelf__tv-screen img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), filter 300ms ease;
	}

	.publication-shelf__tv-play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: 3.4rem;
		height: 3.4rem;
		border-radius: 50%;
		background: #fbfcf5;
		box-shadow: 0.4rem 0.6rem 1rem rgba(23, 42, 82, 0.28);
		place-items: center;
		transform: translate(-50%, -50%);
		transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), background 300ms ease;
	}

	.publication-shelf__tv-play::after {
		width: 0;
		height: 0;
		margin-left: 0.2rem;
		border-top: 0.5rem solid transparent;
		border-bottom: 0.5rem solid transparent;
		border-left: 0.75rem solid #1769e8;
		content: '';
	}

	.publication-shelf__television:hover .publication-shelf__tv-screen img,
	.publication-shelf__television:focus-visible .publication-shelf__tv-screen img {
		filter: saturate(1.12) brightness(1.04);
		transform: scale(1.035);
	}

	.publication-shelf__television:hover .publication-shelf__tv-play,
	.publication-shelf__television:focus-visible .publication-shelf__tv-play {
		background: #ffffff;
		transform: translate(-50%, -50%) scale(1.12);
	}

	.publication-shelf__tv-controls {
		display: flex;
		justify-content: flex-end;
		gap: 0.35rem;
		padding: 0.55rem 0.2rem 0;
	}

	.publication-shelf__tv-controls i {
		display: block;
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: #5474db;
		box-shadow: inset 0 0.08rem 0.12rem rgba(255, 255, 255, 0.75);
	}

	.publication-shelf__tv-stand {
		display: block;
		width: 38%;
		height: 0.58rem;
		margin: -0.02rem auto 0;
		border-radius: 0 0 999px 999px;
		background: linear-gradient(180deg, #8ca9f2, #6078d8);
	}

	.publication-shelf__frame::after {
		position: absolute;
		inset: 0;
		border: 0.55rem solid rgba(255, 255, 255, 0.26);
		content: '';
		pointer-events: none;
	}

	.publication-shelf__frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: #ffffff;
	}

	.publication-shelf__hover-label {
		position: absolute;
		top: 8%;
		right: -12%;
		z-index: 4;
		display: block;
		padding: 1rem 1.25rem;
		border-radius: 999px;
		background: #fbfcf5;
		box-shadow: 0.4rem 0.7rem 1.3rem rgba(36, 68, 125, 0.2);
		color: #1d2b54;
		font-family: var(--font-display);
		font-size: clamp(1rem, 1.7vw, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 0.9;
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.8rem) rotate(3deg);
		transition: opacity 260ms ease, transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.publication-shelf__object--public .publication-shelf__hover-label {
		right: -12%;
		left: auto;
		transform: translateY(0.8rem) rotate(3deg);
	}

	.publication-shelf__object:hover .publication-shelf__hover-label,
	.publication-shelf__object:focus-visible .publication-shelf__hover-label {
		opacity: 1;
		transform: translateY(0) rotate(3deg);
	}

	.publication-shelf__object--public:hover .publication-shelf__hover-label,
	.publication-shelf__object--public:focus-visible .publication-shelf__hover-label {
		transform: translateY(0) rotate(3deg);
	}

	@media (max-width: 700px) {
		.publication-shelf__triangle {
			grid-template-columns: 1fr;
			min-height: auto;
			gap: 2rem;
		}

		.publication-shelf__object--article {
			order: 1;
			grid-column: auto;
			grid-row: auto;
			justify-self: center;
			width: min(82%, 23rem);
			transform: none;
		}

		.publication-shelf__object--journal,
		.publication-shelf__object--public {
			width: min(82%, 23rem);
			grid-column: auto;
			grid-row: auto;
			justify-self: center;
			margin-top: 0;
			transform: none;
		}

		.publication-shelf__object--public {
			order: 2;
		}

		.publication-shelf__object--journal {
			order: 3;
		}

		.publication-shelf__accept-character {
			width: clamp(7.5rem, 40vw, 10rem);
			bottom: 80%;
			left: 50%;
		}

		.publication-shelf__object--article:hover,
		.publication-shelf__object--article:focus-visible,
		.publication-shelf__object--journal:hover,
		.publication-shelf__object--journal:focus-visible,
		.publication-shelf__object--public:hover,
		.publication-shelf__object--public:focus-visible {
			transform: translateY(-0.6rem) rotate(2deg);
		}

		.publication-shelf__object--public:hover .publication-shelf__hover-label,
		.publication-shelf__object--public:focus-visible .publication-shelf__hover-label {
			transform: translateY(0) rotate(3deg);
		}

		.publication-shelf__hover-label {
			right: -4%;
		}

		.publication-shelf__object--public .publication-shelf__hover-label {
			right: -4%;
			left: auto;
		}
	}

	@media (max-width: 560px) {
		.publication-shelf {
			padding-right: 1rem;
			padding-left: 1rem;
		}

		.publication-shelf__heading h2 {
			font-size: clamp(4.2rem, 19vw, 7rem);
		}

		.publication-shelf__object--article {
			width: min(88%, 20rem);
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.publication-shelf__object,
		.publication-shelf__hover-label,
		.publication-shelf__accept-character {
			transition: none;
		}
	}
</style>
